POSTGRES_DB=PrivateCloudDrive
POSTGRES_USER=privateclouddrive
POSTGRES_PASSWORD=privateclouddrive
STRING_ENCRYPTION_PASSPHRASE=change-this-32-character-secret
PUBLIC_URL=http://localhost:8080
AUTH_SERVER_REQUIRE_HTTPS_METADATA=false
SWAGGER_ENABLED=true
ALLOW_INSECURE_LOCAL_VALIDATION=true
PUBLIC_SHARE_PASSWORD_RATE_LIMIT_PERMIT_LIMIT=10
PUBLIC_SHARE_PASSWORD_RATE_LIMIT_WINDOW_MINUTES=10
FILECENTER_STORAGE_PROVIDER=FileSystem
FILECENTER_STORAGE_PATH=/app/storage
ALIYUN_OSS_ACCESS_KEY_ID=
ALIYUN_OSS_ACCESS_KEY_SECRET=
ALIYUN_OSS_ENDPOINT=
ALIYUN_OSS_REGION_ID=
ALIYUN_OSS_BUCKET=
ALIYUN_OSS_CREATE_BUCKET=false

PASSWORD_LOGIN_RATE_LIMIT_ENABLED=true
PASSWORD_LOGIN_RATE_LIMIT_MAX_FAILED_ATTEMPTS=5
PASSWORD_LOGIN_RATE_LIMIT_WINDOW_MINUTES=15

WECHAT_ENABLED=false
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_SCOPE=snsapi_userinfo
WECHAT_CALLBACK_SCHEME=privateclouddrive
WECHAT_ANDROID_PACKAGE_NAME=com.companyname.privateclouddrive.app
WECHAT_ANDROID_SIGNATURE=
WECHAT_IOS_BUNDLE_ID=com.companyname.privateclouddrive.app
WECHAT_IOS_URL_SCHEME=
WECHAT_BINDING_TICKET_LIFETIME_MINUTES=5
WECHAT_REQUEST_TIMEOUT_SECONDS=10
WECHAT_RATE_LIMIT_WINDOW_SECONDS=300
WECHAT_RATE_LIMIT_MAX_ATTEMPTS=60

EXTERNAL_BINDING_TICKET_LIFETIME_MINUTES=5
EXTERNAL_REQUEST_TIMEOUT_SECONDS=10
EXTERNAL_RATE_LIMIT_WINDOW_SECONDS=300
EXTERNAL_RATE_LIMIT_MAX_ATTEMPTS=60

GOOGLE_LOGIN_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=privateclouddrive://callback
GOOGLE_SCOPE=openid profile email
GOOGLE_USE_PKCE=true

GITHUB_LOGIN_ENABLED=false
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=privateclouddrive://callback
GITHUB_SCOPE=
GITHUB_USE_PKCE=true
MINIO_ROOT_USER=privateclouddrive
MINIO_ROOT_PASSWORD=change-me-too
# QA low-privilege test account seed contract
# Do not put real passwords/tokens in committed files. For local runs, prefer:
#   PCD_QA_TEST_ACCOUNT_PASSWORD_FILE=.secrets/qa-test-account.password
PCD_QA_TEST_ACCOUNT_ENABLED=false
PCD_QA_TEST_ACCOUNT_USER_NAME=qa_user
PCD_QA_TEST_ACCOUNT_ALT_USER_NAME=qa_user_alt
PCD_QA_TEST_ACCOUNT_ROLE=QA.Tester
PCD_QA_TEST_ACCOUNT_PASSWORD=
PCD_QA_TEST_ACCOUNT_PASSWORD_FILE=
PCD_QA_TEST_ACCOUNT_SECRET_ID=local/.secrets/qa-test-account.password
PCD_QA_TEST_ACCOUNT_ROTATED_AT=
