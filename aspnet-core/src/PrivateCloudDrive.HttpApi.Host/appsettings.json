{
  "App": {
    "SelfUrl": "https://localhost:44343",
    "CorsOrigins": "https://*.PrivateCloudDrive.com",
    "RedirectAllowedUrls": ""
  },
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5432;Database=PrivateCloudDrive;User ID=root;Password=privateclouddrive;"
  },
  "AuthServer": {
    "Authority": "https://localhost:44343",
    "RequireHttpsMetadata": true,
    "SwaggerClientId": "PrivateCloudDrive_Swagger"
  },
  "Swagger": {
    "Enabled": false
  },
  "Security": {
    "AllowInsecureTransportForLocalValidation": false,
    "PublicSharePasswordRateLimit": {
      "PermitLimit": 10,
      "WindowMinutes": 10,
      "QueueLimit": 0
    }
  },
  "FileCenter": {
    "StorageProvider": "FileSystem",
    "StorageRootPath": "App_Data/FileCenter",
    "AliyunOss": {
      "AccessKeyId": "",
      "AccessKeySecret": "",
      "Endpoint": "",
      "RegionId": "",
      "BucketName": "",
      "CreateBucketIfNotExists": false
    },
    "MediaProcessing": {
      "FfprobePath": "ffprobe",
      "FfmpegPath": "ffmpeg",
      "VideoThumbnailWidth": 320
    }
  },
  "MobileAuth": {
    "LoginRateLimit": {
      "EnablePasswordLoginRateLimit": true,
      "MaxFailedAttempts": 5,
      "WindowMinutes": 15
    }
  },
  "Authentication": {
    "WeChat": {
      "Enabled": false,
      "AppId": "",
      "AppSecret": "",
      "Scope": "snsapi_userinfo",
      "CallbackScheme": "privateclouddrive",
      "Android": {
        "PackageName": "com.companyname.privateclouddrive.app",
        "Signature": ""
      },
      "iOS": {
        "BundleId": "com.companyname.privateclouddrive.app",
        "UrlScheme": ""
      },
      "BindingTicketLifetimeMinutes": 5,
      "RequestTimeoutSeconds": 10,
      "RateLimitWindowSeconds": 300,
      "RateLimitMaxAttempts": 60
    }
  },
  "StringEncryption": {
    "DefaultPassPhrase": "change-this-32-character-secret"
  }
}
