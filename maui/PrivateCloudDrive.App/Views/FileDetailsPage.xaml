<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:loc="clr-namespace:PrivateCloudDrive.App.Localization"
             x:Class="PrivateCloudDrive.App.Views.FileDetailsPage"
             Title="{x:Static loc:AppText.Details}">
    <Grid Padding="0" RowDefinitions="Auto,Auto,*" RowSpacing="16">
        <VerticalStackLayout Padding="18,18,18,0"
                             Spacing="4">
            <Label Text="{x:Static loc:AppText.Details}" Style="{StaticResource PageTitleLabel}" />
            <Label Text="{Binding FileName}" Style="{StaticResource MetaLabel}" />
        </VerticalStackLayout>

        <Border x:Name="DetailsStatePanel"
                Grid.Row="1"
                Margin="18,0,18,0"
                Padding="14"
                IsVisible="False"
                BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}"
                StrokeThickness="2">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="8" />
            </Border.StrokeShape>
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                <ActivityIndicator x:Name="DetailsLoadingIndicator"
                                   WidthRequest="20"
                                   HeightRequest="20"
                                   Color="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                <Label x:Name="DetailsStateLabel"
                       Grid.Column="1"
                       VerticalOptions="Center"
                       FontSize="13"
                       LineBreakMode="WordWrap"
                       TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
                <Button x:Name="DetailsBackButton"
                        Grid.Column="2"
                        Text="{x:Static loc:AppText.Back}"
                        IsVisible="False"
                        Style="{StaticResource SecondaryButton}"
                        Clicked="OnBackClicked" />
            </Grid>
        </Border>

        <ScrollView Grid.Row="2">
            <VerticalStackLayout Spacing="12">
                <Grid x:Name="ImagePreviewPanel"
                      HeightRequest="300"
                      IsVisible="{Binding IsImageDetails}"
                      BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceAltLight}, Dark={StaticResource SurfaceAltDark}}">
                    <Image x:Name="DetailsPreviewImage"
                           Aspect="AspectFill"
                           HorizontalOptions="Fill"
                           VerticalOptions="Fill"
                           IsVisible="False" />
                    <VerticalStackLayout x:Name="ImagePreviewStatusPanel"
                                         Spacing="10"
                                         HorizontalOptions="Center"
                                         VerticalOptions="Center"
                                         Padding="16">
                        <ActivityIndicator x:Name="ImagePreviewLoadingIndicator"
                                           WidthRequest="24"
                                           HeightRequest="24"
                                           IsRunning="False" />
                        <Label x:Name="ImagePreviewStatusLabel"
                               Text="{x:Static loc:AppText.LoadingImagePreview}"
                               Style="{StaticResource MetaLabel}"
                               HorizontalTextAlignment="Center"
                               LineBreakMode="WordWrap" />
                        <Button x:Name="ImagePreviewRetryButton"
                                Text="{x:Static loc:AppText.Retry}"
                                Style="{StaticResource SecondaryButton}"
                                IsVisible="False"
                                Clicked="OnRetryImagePreviewClicked" />
                    </VerticalStackLayout>
                </Grid>

                <Border Padding="16"
                        Margin="18,0,18,0"
                        BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}"
                        StrokeThickness="2">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="8" />
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="12">
                        <Label Text="{Binding FileName}"
                               Style="{StaticResource SectionTitleLabel}"
                               LineBreakMode="WordWrap" />
                        <Grid RowDefinitions="Auto,Auto,Auto,Auto" ColumnDefinitions="110,*" RowSpacing="10">
                            <Label Text="{x:Static loc:AppText.Type}" Style="{StaticResource MetaLabel}" />
                            <Label Grid.Column="1" Text="{Binding FileKind}" />

                            <Label Grid.Row="1" Text="{x:Static loc:AppText.Size}" Style="{StaticResource MetaLabel}" />
                            <Label Grid.Row="1" Grid.Column="1" Text="{Binding FileSize}" />

                            <Label Grid.Row="2" Text="{x:Static loc:AppText.Modified}" Style="{StaticResource MetaLabel}" />
                            <Label Grid.Row="2" Grid.Column="1" Text="{Binding ModifiedAt}" />

                            <Label Grid.Row="3" Text="Id" Style="{StaticResource MetaLabel}" />
                            <Label Grid.Row="3"
                                   Grid.Column="1"
                                   Text="{Binding FileId}"
                                   FontSize="13"
                                   LineBreakMode="TailTruncation" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <Border Padding="16"
                        Margin="18,0,18,18"
                        BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}"
                        StrokeThickness="2">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="8" />
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="6">
                        <Label Text="{x:Static loc:AppText.AvailableActions}" Style="{StaticResource SectionTitleLabel}" />
                        <Label x:Name="ActionStateLabel"
                               Text="{Binding FavoriteStateText}"
                               Style="{StaticResource MetaLabel}"
                               LineBreakMode="WordWrap" />
                        <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="10">
                            <Button x:Name="FavoriteButton"
                                    Text="{Binding FavoriteButtonText}"
                                    TextColor="{StaticResource DoodleInk}"
                                    Clicked="OnFavoriteClicked" />
                            <Button Grid.Column="1"
                                    Text="{x:Static loc:AppText.AddTag}"
                                    Style="{StaticResource SecondaryButton}"
                                    Clicked="OnAddTagClicked" />
                            <Button Grid.Row="1"
                                    Grid.ColumnSpan="2"
                                    Text="{x:Static loc:AppText.CreateShareLink}"
                                    Style="{StaticResource SecondaryButton}"
                                    Clicked="OnCreateShareClicked" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
