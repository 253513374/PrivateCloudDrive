<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:loc="clr-namespace:PrivateCloudDrive.App.Localization"
             x:Class="PrivateCloudDrive.App.Views.StartupPage"
             Shell.NavBarIsVisible="False">
    <Grid Padding="28" RowDefinitions="*,Auto,*">
        <VerticalStackLayout Grid.Row="1" Spacing="18" HorizontalOptions="Center">
            <Image Source="privateclouddrive_mark.png"
                   HeightRequest="88"
                   WidthRequest="88"
                   Aspect="AspectFit"
                   HorizontalOptions="Center"
                   SemanticProperties.Description="PrivateCloudDrive" />
            <Label Text="PrivateCloudDrive"
                   Style="{StaticResource PageTitleLabel}"
                   HorizontalTextAlignment="Center" />
            <Label x:Name="StartupStatusLabel"
                   Text="{x:Static loc:AppText.CheckingSignInStatus}"
                   Style="{StaticResource MetaLabel}"
                   HorizontalTextAlignment="Center" />
            <ActivityIndicator x:Name="StartupLoadingIndicator"
                               IsRunning="True"
                               HorizontalOptions="Center" />
            <Border x:Name="StartupErrorPanel"
                    Padding="14"
                    IsVisible="False"
                    BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}"
                    StrokeThickness="1"
                    MaximumWidthRequest="360">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="8" />
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="10">
                    <Label x:Name="StartupErrorLabel"
                           FontSize="13"
                           LineBreakMode="WordWrap"
                           HorizontalTextAlignment="Center"
                           TextColor="{StaticResource Danger}" />
                    <Button Text="{x:Static loc:AppText.Retry}"
                            Style="{StaticResource SecondaryButton}"
                            Clicked="OnRetryClicked" />
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </Grid>
</ContentPage>
