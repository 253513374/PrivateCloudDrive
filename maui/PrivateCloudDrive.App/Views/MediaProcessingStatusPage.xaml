<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:PrivateCloudDrive.App.Models"
             x:Class="PrivateCloudDrive.App.Views.MediaProcessingStatusPage"
             Title="处理状态">
    <Grid Padding="18" RowDefinitions="Auto,Auto,Auto,*" RowSpacing="14">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <VerticalStackLayout Spacing="4">
                <Label Text="处理队列" Style="{StaticResource PageTitleLabel}" />
                <Label Text="{Binding ItemCountText}" Style="{StaticResource MetaLabel}" />
            </VerticalStackLayout>
            <Button Grid.Column="1"
                    Text="刷新"
                    Style="{StaticResource SecondaryButton}"
                    Clicked="OnRefreshClicked" />
        </Grid>

        <HorizontalStackLayout Grid.Row="1" Spacing="8">
            <Button x:Name="AllStatusButton" Text="全部" Style="{StaticResource SegmentButtonSelected}" Clicked="OnAllClicked" />
            <Button x:Name="PendingStatusButton" Text="等待中" Style="{StaticResource SegmentButton}" Clicked="OnPendingClicked" />
            <Button x:Name="ProcessingStatusButton" Text="处理中" Style="{StaticResource SegmentButton}" Clicked="OnProcessingClicked" />
            <Button x:Name="FailedStatusButton" Text="失败" Style="{StaticResource SegmentButton}" Clicked="OnFailedClicked" />
            <Button x:Name="CompletedStatusButton" Text="已完成" Style="{StaticResource SegmentButton}" Clicked="OnCompletedClicked" />
        </HorizontalStackLayout>

        <Border x:Name="StatePanel"
                Grid.Row="2"
                Padding="14"
                IsVisible="False"
                BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}"
                StrokeThickness="1">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="8" />
            </Border.StrokeShape>
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                <ActivityIndicator x:Name="LoadingIndicator"
                                   WidthRequest="20"
                                   HeightRequest="20"
                                   Color="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                <Label x:Name="StateLabel" Grid.Column="1" VerticalOptions="Center" FontSize="13" LineBreakMode="WordWrap" />
            </Grid>
        </Border>

        <CollectionView Grid.Row="3"
                        ItemsSource="{Binding Items}"
                        SelectionMode="Single"
                        SelectionChanged="OnItemSelected">
            <CollectionView.EmptyView>
                <Border Padding="18"
                        BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}"
                        StrokeThickness="1">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="8" />
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="6" HorizontalOptions="Center" VerticalOptions="Center">
                        <Label Text="没有匹配的处理任务" Style="{StaticResource SectionTitleLabel}" HorizontalTextAlignment="Center" />
                        <Label Text="等待、处理中、失败和已完成的媒体任务会显示在这里。" Style="{StaticResource MetaLabel}" HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </Border>
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:MediaLibraryItem">
                    <Grid Padding="0,0,0,10">
                        <Border Padding="12"
                                BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}"
                                StrokeThickness="1">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="8" />
                            </Border.StrokeShape>
                            <Grid ColumnDefinitions="82,*,Auto" ColumnSpacing="12">
                                <Border WidthRequest="82" HeightRequest="62" StrokeThickness="1" Stroke="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}" BackgroundColor="{AppThemeBinding Light={StaticResource PrimarySoftLight}, Dark={StaticResource PrimarySoftDark}}">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="8" />
                                    </Border.StrokeShape>
                                    <Grid>
                                        <Image Source="{Binding ThumbnailSource}" Aspect="AspectFill" IsVisible="{Binding HasThumbnail}" />
                                        <Label Text="{Binding Badge}" IsVisible="{Binding ShowBadge}" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" />
                                    </Grid>
                                </Border>
                                <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                                    <Label Text="{Binding Name}" FontAttributes="Bold" LineBreakMode="TailTruncation" />
                                    <HorizontalStackLayout Spacing="6">
                                        <Border Padding="6,2"
                                                IsVisible="{Binding IsProcessFailed}"
                                                BackgroundColor="{StaticResource Danger}"
                                                StrokeThickness="0">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="8" />
                                            </Border.StrokeShape>
                                            <Label Text="{Binding ProcessStatusText}" FontSize="11" TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
                                        </Border>
                                        <Border Padding="6,2"
                                                IsVisible="{Binding IsProcessActive}"
                                                BackgroundColor="{StaticResource Warning}"
                                                StrokeThickness="0">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="8" />
                                            </Border.StrokeShape>
                                            <Label Text="{Binding ProcessStatusText}" FontSize="11" TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
                                        </Border>
                                        <Border Padding="6,2"
                                                IsVisible="{Binding IsProcessCompleted}"
                                                BackgroundColor="{StaticResource Success}"
                                                StrokeThickness="0">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="8" />
                                            </Border.StrokeShape>
                                            <Label Text="{Binding ProcessStatusText}" FontSize="11" TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
                                        </Border>
                                        <Label Text="{Binding DisplayKind}" Style="{StaticResource MetaLabel}" VerticalOptions="Center" />
                                    </HorizontalStackLayout>
                                    <Label Text="{Binding StatusDetailText}" Style="{StaticResource MetaLabel}" LineBreakMode="TailTruncation" />
                                </VerticalStackLayout>
                                <Button Grid.Column="2"
                                        Text="重试"
                                        Style="{StaticResource SecondaryButton}"
                                        IsVisible="{Binding IsProcessFailed}"
                                        CommandParameter="{Binding Id}"
                                        Clicked="OnRetryProcessingClicked" />
                            </Grid>
                        </Border>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
