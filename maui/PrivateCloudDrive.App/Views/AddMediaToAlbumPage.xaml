<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:PrivateCloudDrive.App.Models"
             x:Class="PrivateCloudDrive.App.Views.AddMediaToAlbumPage"
             Title="添加媒体">
    <Grid Padding="18" RowDefinitions="Auto,Auto,*,Auto" RowSpacing="14">
        <Border Padding="14"
                BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}"
                StrokeThickness="2">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="8" />
            </Border.StrokeShape>
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <VerticalStackLayout Spacing="4">
                    <Label Text="添加到相册" Style="{StaticResource PageTitleLabel}" />
                    <Label Text="{Binding HeaderText}" Style="{StaticResource MetaLabel}" />
                </VerticalStackLayout>
                <Button Grid.Column="1"
                        x:Name="RefreshButton"
                        Text="刷新"
                        Style="{StaticResource SecondaryButton}"
                        Clicked="OnRefreshClicked"
                        VerticalOptions="Center" />
            </Grid>
        </Border>

        <Grid Grid.Row="1" RowDefinitions="Auto,Auto" RowSpacing="10">
            <HorizontalStackLayout Spacing="8">
                <Button x:Name="AllMediaButton"
                        Text="全部"
                        Style="{StaticResource SegmentButtonSelected}"
                        Clicked="OnAllMediaClicked" />
                <Button x:Name="ImagesButton"
                        Text="图片"
                        Style="{StaticResource SegmentButton}"
                        Clicked="OnImagesClicked" />
                <Button x:Name="VideosButton"
                        Text="视频"
                        Style="{StaticResource SegmentButton}"
                        Clicked="OnVideosClicked" />
            </HorizontalStackLayout>

            <Border x:Name="StatePanel"
                    Grid.Row="1"
                    Padding="14"
                    IsVisible="False"
                    BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}"
                    StrokeThickness="2">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="8" />
                </Border.StrokeShape>
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                    <ActivityIndicator x:Name="LoadingIndicator"
                                       WidthRequest="20"
                                       HeightRequest="20"
                                       Color="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                    <Label x:Name="StateLabel"
                           Grid.Column="1"
                           VerticalOptions="Center"
                           FontSize="13"
                           LineBreakMode="WordWrap" />
                </Grid>
            </Border>
        </Grid>

        <CollectionView x:Name="MediaCollectionView"
                        Grid.Row="2"
                        ItemsSource="{Binding Items}"
                        SelectionMode="Single"
                        SelectionChanged="OnMediaSelected">
            <CollectionView.ItemsLayout>
                <GridItemsLayout Orientation="Vertical" Span="3" HorizontalItemSpacing="8" VerticalItemSpacing="10" />
            </CollectionView.ItemsLayout>
            <CollectionView.EmptyView>
                <Border Padding="18"
                        BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}"
                        StrokeThickness="2">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="8" />
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="6" HorizontalOptions="Center" VerticalOptions="Center">
                        <Label Text="没有可添加的媒体" Style="{StaticResource SectionTitleLabel}" HorizontalTextAlignment="Center" />
                        <Label Text="当前筛选下的媒体已经在此相册中。" Style="{StaticResource MetaLabel}" HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </Border>
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:SelectableMediaLibraryItem">
                    <Border BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}"
                            StrokeThickness="2">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="8" />
                        </Border.StrokeShape>
                        <Grid RowDefinitions="104,Auto">
                            <Grid BackgroundColor="{AppThemeBinding Light={StaticResource PrimarySoftLight}, Dark={StaticResource PrimarySoftDark}}">
                                <Image Source="{Binding ThumbnailSource}" Aspect="AspectFill" IsVisible="{Binding HasThumbnail}" />
                                <Label Text="{Binding Badge}"
                                       IsVisible="{Binding ShowBadge}"
                                       FontAttributes="Bold"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"
                                       TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                                <Border HorizontalOptions="End"
                                        VerticalOptions="End"
                                        Margin="6"
                                        Padding="6,2"
                                        IsVisible="{Binding ShowVideoDuration}"
                                        BackgroundColor="#99000000"
                                        StrokeThickness="0">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="8" />
                                    </Border.StrokeShape>
                                    <Label Text="{Binding DurationText}" FontSize="10" TextColor="{StaticResource DoodleInk}" />
                                </Border>
                                <Border HorizontalOptions="Start"
                                        VerticalOptions="Start"
                                        Margin="6"
                                        Padding="6,2"
                                        IsVisible="{Binding IsSelected}"
                                        BackgroundColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                                        StrokeThickness="0">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="8" />
                                    </Border.StrokeShape>
                                    <Label Text="{Binding SelectionText}" FontSize="10" TextColor="{StaticResource DoodleInk}" />
                                </Border>
                            </Grid>
                            <VerticalStackLayout Grid.Row="1" Padding="8,7,8,8" Spacing="2">
                                <Label Text="{Binding Name}" FontAttributes="Bold" FontSize="12" LineBreakMode="TailTruncation" />
                                <Label Text="{Binding TimelineMetaText}" Style="{StaticResource MetaLabel}" LineBreakMode="TailTruncation" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Border Grid.Row="3"
                Padding="12"
                BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}"
                StrokeThickness="2">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="8" />
            </Border.StrokeShape>
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <Label Text="{Binding SelectionSummaryText}"
                       Style="{StaticResource MetaLabel}"
                       VerticalOptions="Center"
                       LineBreakMode="TailTruncation" />
                <Button Grid.Column="1"
                        Text="{Binding AddButtonText}"
                        TextColor="{StaticResource DoodleInk}"
                        IsEnabled="{Binding CanAddSelected}"
                        Clicked="OnAddSelectedClicked" />
            </Grid>
        </Border>
    </Grid>
</ContentPage>
