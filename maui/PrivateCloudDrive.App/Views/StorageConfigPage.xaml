<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PrivateCloudDrive.App.Views.StorageConfigPage"
             Title="存储配置"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource PageBackgroundDark}">
    <ScrollView>
        <VerticalStackLayout Padding="18,22,18,28"
                             Spacing="16">
            <!-- 标题栏 -->
            <Grid ColumnDefinitions="Auto,*"
                  ColumnSpacing="12">
                <Button Text="‹"
                        Style="{StaticResource GhostButton}"
                        WidthRequest="46"
                        Clicked="OnBackClicked" />
                <VerticalStackLayout Grid.Column="1"
                                     Spacing="2"
                                     VerticalOptions="Center">
                    <Label Text="存储配置"
                           Style="{StaticResource PageTitleLabel}" />
                    <Label Text="来自当前私有备份服务器的存储后端配置"
                           Style="{StaticResource MetaLabel}" />
                </VerticalStackLayout>
            </Grid>

            <!-- 状态面板（加载/错误） -->
            <Border x:Name="StatePanel"
                    Padding="14" IsVisible="False"
                    BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}"
                    StrokeThickness="1">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="8" />
                </Border.StrokeShape>
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                    <ActivityIndicator x:Name="LoadingIndicator"
                                       WidthRequest="20" HeightRequest="20"
                                       Color="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                    <Label x:Name="StateLabel" Grid.Column="1" VerticalOptions="Center" FontSize="13" LineBreakMode="WordWrap" />
                    <Button x:Name="RetryButton" Grid.Column="2" Text="重试" IsVisible="False"
                            Style="{StaticResource SecondaryButton}" Padding="12,6" MinimumHeightRequest="36"
                            Clicked="OnRefreshClicked" />
                </Grid>
            </Border>

            <!-- 存储后端类型 -->
            <Border Padding="18"
                    BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}"
                    Stroke="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="18" />
                </Border.StrokeShape>
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                    <Border HeightRequest="48" WidthRequest="48"
                            BackgroundColor="{AppThemeBinding Light={StaticResource PrimarySoftLight}, Dark={StaticResource PrimarySoftDark}}"
                            StrokeThickness="0" VerticalOptions="Start">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12" />
                        </Border.StrokeShape>
                        <Label Text="📦"
                               FontSize="22"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
                    </Border>
                    <VerticalStackLayout Grid.Column="1" Spacing="6" VerticalOptions="Center">
                        <Label Text="存储后端类型"
                               Style="{StaticResource CaptionLabel}" />
                        <Label x:Name="StorageProviderLabel"
                               Text="--"
                               FontFamily="OpenSansSemibold"
                               FontSize="17"
                               TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
                    </VerticalStackLayout>
                </Grid>
            </Border>

            <!-- 存储路径（脱敏） -->
            <Border Padding="18"
                    BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}"
                    Stroke="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="18" />
                </Border.StrokeShape>
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                    <Border HeightRequest="48" WidthRequest="48"
                            BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceAltLight}, Dark={StaticResource SurfaceAltDark}}"
                            StrokeThickness="0" VerticalOptions="Start">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12" />
                        </Border.StrokeShape>
                        <Label Text="📁"
                               FontSize="22"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
                    </Border>
                    <VerticalStackLayout Grid.Column="1" Spacing="6" VerticalOptions="Center">
                        <Label Text="存储路径"
                               Style="{StaticResource CaptionLabel}" />
                        <Label x:Name="StoragePathLabel"
                               Text="--"
                               FontFamily="OpenSansSemibold"
                               FontSize="17"
                               LineBreakMode="WordWrap"
                               TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
                    </VerticalStackLayout>
                </Grid>
            </Border>

            <!-- 容量卡片 -->
            <Border Padding="18"
                    BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}"
                    Stroke="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="18" />
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="14">
                    <Label Text="存储容量"
                           Style="{StaticResource SectionTitleLabel}" />

                    <Grid ColumnDefinitions="*,*,*" RowDefinitions="Auto,Auto"
                          RowSpacing="8" ColumnSpacing="8">
                        <!-- 总容量 -->
                        <Border Grid.Column="0" Grid.Row="0"
                                Padding="12,10"
                                BackgroundColor="{AppThemeBinding Light={StaticResource PrimarySoftLight}, Dark={StaticResource PrimarySoftDark}}"
                                StrokeThickness="0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="10" />
                            </Border.StrokeShape>
                            <VerticalStackLayout Spacing="4">
                                <Label Text="总容量"
                                       Style="{StaticResource CaptionLabel}" />
                                <Label x:Name="TotalBytesLabel"
                                       Text="--"
                                       FontFamily="OpenSansSemibold"
                                       FontSize="16"
                                       TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
                            </VerticalStackLayout>
                        </Border>

                        <!-- 已用空间 -->
                        <Border Grid.Column="1" Grid.Row="0"
                                Padding="12,10"
                                BackgroundColor="{AppThemeBinding Light={StaticResource PrimarySoftLight}, Dark={StaticResource PrimarySoftDark}}"
                                StrokeThickness="0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="10" />
                            </Border.StrokeShape>
                            <VerticalStackLayout Spacing="4">
                                <Label Text="已用"
                                       Style="{StaticResource CaptionLabel}" />
                                <Label x:Name="UsedBytesLabel"
                                       Text="--"
                                       FontFamily="OpenSansSemibold"
                                       FontSize="16"
                                       TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
                            </VerticalStackLayout>
                        </Border>

                        <!-- 可用空间 -->
                        <Border Grid.Column="2" Grid.Row="0"
                                Padding="12,10"
                                BackgroundColor="{AppThemeBinding Light={StaticResource PrimarySoftLight}, Dark={StaticResource PrimarySoftDark}}"
                                StrokeThickness="0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="10" />
                            </Border.StrokeShape>
                            <VerticalStackLayout Spacing="4">
                                <Label Text="可用"
                                       Style="{StaticResource CaptionLabel}" />
                                <Label x:Name="AvailableBytesLabel"
                                       Text="--"
                                       FontFamily="OpenSansSemibold"
                                       FontSize="16"
                                       TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
                            </VerticalStackLayout>
                        </Border>

                        <!-- 单文件大小上限 (跨三列) -->
                        <Border Grid.ColumnSpan="3" Grid.Column="0" Grid.Row="1"
                                Padding="12,10"
                                BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceAltLight}, Dark={StaticResource SurfaceAltDark}}"
                                StrokeThickness="0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="10" />
                            </Border.StrokeShape>
                            <VerticalStackLayout Spacing="4">
                                <Label Text="单文件大小上限"
                                       Style="{StaticResource CaptionLabel}" />
                                <Label x:Name="MaxSingleFileSizeLabel"
                                       Text="--"
                                       FontFamily="OpenSansSemibold"
                                       FontSize="16"
                                       TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
                            </VerticalStackLayout>
                        </Border>
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- 只读提示 -->
            <Border Padding="18"
                    BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceAltLight}, Dark={StaticResource SurfaceAltDark}}"
                    StrokeThickness="0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12" />
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="6">
                    <Label Text="✦ 只读页面"
                           FontFamily="OpenSansSemibold"
                           FontSize="14" />
                    <Label Text="当前页面仅展示存储配置信息，不可编辑。如需修改存储后端配置，请登录服务器管理控制台操作。"
                           Style="{StaticResource MetaLabel}"
                           LineBreakMode="WordWrap" />
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
