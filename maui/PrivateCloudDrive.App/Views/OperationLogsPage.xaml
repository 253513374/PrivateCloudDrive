<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:loc="clr-namespace:PrivateCloudDrive.App.Localization"
             xmlns:models="clr-namespace:PrivateCloudDrive.App.Models"
             x:Class="PrivateCloudDrive.App.Views.OperationLogsPage"
             Title="{x:Static loc:AppText.OperationLogs}">
    <Grid Padding="18" RowDefinitions="Auto,Auto,Auto,*" RowSpacing="16">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <VerticalStackLayout Spacing="4">
                <Label Text="{x:Static loc:AppText.OperationLogs}" Style="{StaticResource PageTitleLabel}" />
                <Label Text="{Binding ApiBaseUrl}" Style="{StaticResource MetaLabel}" />
            </VerticalStackLayout>
            <Button x:Name="RefreshButton"
                    Grid.Column="1"
                    Text="{x:Static loc:AppText.Refresh}"
                    TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}"
                    VerticalOptions="Center"
                    Clicked="OnRefreshClicked" />
        </Grid>

        <Border x:Name="FilterPanel"
                Grid.Row="1"
                Padding="14"
                BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}"
                StrokeThickness="1">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="8" />
            </Border.StrokeShape>
            <Grid RowDefinitions="Auto,Auto,Auto,Auto" ColumnDefinitions="*,*" RowSpacing="10" ColumnSpacing="10">
                <!-- 用户名 -->
                <VerticalStackLayout Grid.ColumnSpan="2" Spacing="4">
                    <Label Text="{x:Static loc:AppText.UserNameLabel}"
                           FontSize="13"
                           TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                    <Entry x:Name="UserNameEntry"
                           Placeholder="{x:Static loc:AppText.UserNameLabel}"
                           ClearButtonVisibility="WhileEditing" />
                </VerticalStackLayout>

                <!-- 操作类型 -->
                <VerticalStackLayout Grid.Row="1" Grid.ColumnSpan="2" Spacing="4">
                    <Label Text="{x:Static loc:AppText.ActionType}"
                           FontSize="13"
                           TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                    <Picker x:Name="ActionPicker"
                            Title="{x:Static loc:AppText.AllActions}" />
                </VerticalStackLayout>

                <!-- 开始时间 -->
                <VerticalStackLayout Grid.Row="2" Spacing="4">
                    <Label Text="{x:Static loc:AppText.StartTime}"
                           FontSize="13"
                           TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                    <DatePicker x:Name="StartDatePicker" />
                </VerticalStackLayout>

                <!-- 结束时间 -->
                <VerticalStackLayout Grid.Row="2" Grid.Column="1" Spacing="4">
                    <Label Text="{x:Static loc:AppText.EndTime}"
                           FontSize="13"
                           TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                    <DatePicker x:Name="EndDatePicker" />
                </VerticalStackLayout>

                <!-- 按钮 -->
                <HorizontalStackLayout Grid.Row="3" Grid.ColumnSpan="2" Spacing="10" HorizontalOptions="End">
                    <Button x:Name="ResetFilterButton"
                            Text="{x:Static loc:AppText.ResetFilter}"
                            Style="{StaticResource SecondaryButton}"
                            Clicked="OnResetFilterClicked" />
                    <Button x:Name="ApplyFilterButton"
                            Text="{x:Static loc:AppText.ApplyFilter}"
                            Clicked="OnApplyFilterClicked" />
                </HorizontalStackLayout>
            </Grid>
        </Border>

        <Border x:Name="LogsStatePanel"
                Grid.Row="2"
                Padding="14"
                IsVisible="False"
                BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}"
                StrokeThickness="1">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="8" />
            </Border.StrokeShape>
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                <ActivityIndicator x:Name="LogsLoadingIndicator"
                                   WidthRequest="20"
                                   HeightRequest="20"
                                   Color="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                <Label x:Name="LogsStateLabel"
                       Grid.Column="1"
                       VerticalOptions="Center"
                       FontSize="13"
                       LineBreakMode="WordWrap"
                       TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
                <Button x:Name="LogsRetryButton"
                        Grid.Column="2"
                        Text="{x:Static loc:AppText.Retry}"
                        IsVisible="False"
                        Style="{StaticResource SecondaryButton}"
                        Clicked="OnRetryClicked" />
            </Grid>
        </Border>

        <CollectionView Grid.Row="3"
                        ItemsSource="{Binding Logs}">
            <CollectionView.EmptyView>
                <Border Padding="18"
                        BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}"
                        StrokeThickness="1">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="8" />
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="6" HorizontalOptions="Center" VerticalOptions="Center">
                        <Label Text="{x:Static loc:AppText.NoLogsFound}"
                               Style="{StaticResource SectionTitleLabel}"
                               HorizontalTextAlignment="Center" />
                        <Label Text="{x:Static loc:AppText.LogsEmptyHelp}"
                               Style="{StaticResource MetaLabel}"
                               HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </Border>
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:CloudOperationLog">
                    <Grid Padding="0,0,0,10">
                        <Border Padding="14"
                                BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}"
                                StrokeThickness="1">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="8" />
                            </Border.StrokeShape>
                            <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,Auto" RowSpacing="6" ColumnSpacing="10">
                                <Label Text="{Binding Action}"
                                       FontAttributes="Bold"
                                       FontSize="15"
                                       TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
                                <Label Grid.Column="1"
                                       Text="{Binding Source}"
                                       FontSize="12"
                                       TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                                <Label Grid.Row="1"
                                       Text="{Binding Summary}"
                                       FontSize="13"
                                       LineBreakMode="TailTruncation"
                                       TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                                <Label Grid.Row="1"
                                       Grid.Column="1"
                                       Text="{Binding DisplayStatus}"
                                       FontSize="12"
                                       HorizontalTextAlignment="End"
                                       TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                                <Label Grid.Row="2"
                                       Text="{Binding DisplayUser}"
                                       Style="{StaticResource MetaLabel}" />
                                <Label Grid.Row="2"
                                       Grid.Column="1"
                                       Text="{Binding DisplayTime}"
                                       Style="{StaticResource MetaLabel}"
                                       HorizontalTextAlignment="End" />
                            </Grid>
                        </Border>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
