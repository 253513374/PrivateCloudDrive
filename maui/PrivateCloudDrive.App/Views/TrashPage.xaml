<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:loc="clr-namespace:PrivateCloudDrive.App.Localization"
             xmlns:models="clr-namespace:PrivateCloudDrive.App.Models"
             x:Class="PrivateCloudDrive.App.Views.TrashPage"
             Title="{x:Static loc:AppText.Trash}">
    <Grid Padding="18" RowDefinitions="Auto,Auto,Auto,Auto,*" RowSpacing="16">
        <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="10">
            <VerticalStackLayout Spacing="4">
                <Label Text="{x:Static loc:AppText.Trash}"
                       Style="{StaticResource PageTitleLabel}" />
                <Label Text="{x:Static loc:AppText.RestoreItemsOrRemovePermanently}"
                       Style="{StaticResource MetaLabel}" />
            </VerticalStackLayout>
            <Button Grid.Column="1"
                    Text="{x:Static loc:AppText.Refresh}"
                    Style="{StaticResource SecondaryButton}"
                    VerticalOptions="Center"
                    Clicked="OnRefreshClicked" />
            <Button Grid.Column="2"
                    Text="{x:Static loc:AppText.Empty}"
                    Style="{StaticResource DangerButton}"
                    VerticalOptions="Center"
                    Clicked="OnEmptyTrashClicked" />
            <Button x:Name="TrashSelectionModeButton"
                    Grid.Column="3"
                    Text="选择"
                    Style="{StaticResource SecondaryButton}"
                    VerticalOptions="Center"
                    Clicked="OnToggleSelectionModeClicked" />
        </Grid>

        <!-- 回收站存储信息 -->
        <Border x:Name="TrashStoragePanel"
                Grid.Row="1"
                Padding="14"
                IsVisible="False"
                BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceAltLight}, Dark={StaticResource SurfaceAltDark}}"
                StrokeThickness="0">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="10" />
            </Border.StrokeShape>
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                <VerticalStackLayout Spacing="4">
                    <HorizontalStackLayout Spacing="8">
                        <Label x:Name="TrashUsedBytesLabel"
                               Text="--"
                               FontFamily="OpenSansSemibold"
                               FontSize="16"
                               TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
                        <Label Text="已使用"
                               FontSize="14"
                               VerticalOptions="Center"
                               TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                    </HorizontalStackLayout>
                    <Label x:Name="TrashCleanupSuggestionLabel"
                           Text=""
                           Style="{StaticResource MetaLabel}"
                           LineBreakMode="WordWrap" />
                </VerticalStackLayout>
                <ActivityIndicator x:Name="TrashStorageLoadingIndicator"
                                   Grid.Column="1"
                                   WidthRequest="20" HeightRequest="20"
                                   Color="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                                   VerticalOptions="Center" />
            </Grid>
        </Border>

        <Border x:Name="TrashBatchToolbar"
                Grid.Row="2"
                Padding="12"
                IsVisible="False"
                BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}"
                StrokeThickness="1">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="8" />
            </Border.StrokeShape>
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                <Label x:Name="TrashSelectedCountLabel"
                       Text="已选择 0 项"
                       FontAttributes="Bold"
                       VerticalOptions="Center"
                       TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
                <Button Grid.Column="1"
                        Text="{x:Static loc:AppText.Restore}"
                        TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}"
                        Clicked="OnBatchRestoreClicked" />
                <Button Grid.Column="2"
                        Text="{x:Static loc:AppText.DeleteForever}"
                        Style="{StaticResource DangerButton}"
                        Clicked="OnBatchPermanentDeleteClicked" />
            </Grid>
        </Border>

        <Border x:Name="StatePanel"
                Grid.Row="3"
                Padding="14"
                IsVisible="False"
                BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}"
                StrokeThickness="1">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="8" />
            </Border.StrokeShape>
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                <ActivityIndicator x:Name="LoadingIndicator"
                                   WidthRequest="20"
                                   HeightRequest="20"
                                   Color="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                <Label x:Name="StateLabel"
                       Grid.Column="1"
                       VerticalOptions="Center"
                       FontSize="13"
                       LineBreakMode="WordWrap"
                       TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
                <Button x:Name="TrashRetryButton"
                        Grid.Column="2"
                        Text="{x:Static loc:AppText.Retry}"
                        IsVisible="False"
                        Style="{StaticResource SecondaryButton}"
                        Clicked="OnRefreshClicked" />
            </Grid>
        </Border>

        <CollectionView x:Name="TrashCollectionView"
                        Grid.Row="4"
                        ItemsSource="{Binding TrashItems}"
                        SelectionMode="None"
                        SelectionChanged="OnTrashSelectionChanged">
            <CollectionView.EmptyView>
                <Border Padding="18"
                        BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}"
                        StrokeThickness="1">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="8" />
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="6"
                                         HorizontalOptions="Center"
                                         VerticalOptions="Center"
                                         MinimumHeightRequest="280">
                        <Label Text="{x:Static loc:AppText.TrashIsEmpty}"
                               Style="{StaticResource SectionTitleLabel}"
                               HorizontalTextAlignment="Center" />
                        <Label Text="{x:Static loc:AppText.RestoreItemsOrRemovePermanently}"
                               Style="{StaticResource MetaLabel}"
                               HorizontalTextAlignment="Center"
                               LineBreakMode="WordWrap" />
                    </VerticalStackLayout>
                </Border>
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:CloudDriveItem">
                    <Grid Padding="0,0,0,10">
                        <Border Padding="14"
                                BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}"
                                StrokeThickness="1">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="8" />
                            </Border.StrokeShape>
                            <Grid ColumnDefinitions="52,*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="10">
                                <Border HeightRequest="44"
                                        WidthRequest="44"
                                        BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceAltLight}, Dark={StaticResource SurfaceAltDark}}"
                                        StrokeThickness="0"
                                        VerticalOptions="Center">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="8" />
                                    </Border.StrokeShape>
                                    <Label Text="{Binding Badge}"
                                           FontAttributes="Bold"
                                           FontSize="11"
                                           TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center" />
                                </Border>
                                <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                                    <Label Text="{Binding Name}"
                                           FontAttributes="Bold"
                                           FontSize="16"
                                           TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
                                    <Label Text="{Binding DisplayKind}"
                                           FontSize="13"
                                           TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="2"
                                                     Spacing="3"
                                                     HorizontalOptions="End"
                                                     VerticalOptions="Center">
                                    <Label Text="{Binding Size}"
                                           FontSize="13"
                                           HorizontalTextAlignment="End"
                                           TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
                                    <Label Text="{Binding ModifiedAt}"
                                           FontSize="12"
                                           HorizontalTextAlignment="End"
                                           TextColor="{AppThemeBinding Light={StaticResource TextTertiaryLight}, Dark={StaticResource TextTertiaryDark}}" />
                                </VerticalStackLayout>
                                <HorizontalStackLayout Grid.Row="1"
                                                       Grid.ColumnSpan="3"
                                                       HorizontalOptions="End"
                                                       Spacing="8">
                                    <Button Text="{x:Static loc:AppText.Restore}"
                                            FontSize="12"
                                            HeightRequest="44"
                                            Padding="12,0"
                                            TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}"
                                            CommandParameter="{Binding .}"
                                            Clicked="OnRestoreClicked" />
                                    <Button Text="{x:Static loc:AppText.DeleteForever}"
                                            FontSize="12"
                                            HeightRequest="44"
                                            Padding="12,0"
                                            Style="{StaticResource DangerButton}"
                                            CommandParameter="{Binding .}"
                                            Clicked="OnPermanentDeleteClicked" />
                                </HorizontalStackLayout>
                            </Grid>
                        </Border>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
