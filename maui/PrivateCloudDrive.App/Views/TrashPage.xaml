<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:PrivateCloudDrive.App.Models"
             x:Class="PrivateCloudDrive.App.Views.TrashPage"
             Title="Trash">
    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Refresh" Clicked="OnRefreshClicked" />
        <ToolbarItem Text="Empty" Clicked="OnEmptyTrashClicked" />
    </ContentPage.ToolbarItems>

    <Grid Padding="18" RowDefinitions="Auto,Auto,*" RowSpacing="16">
        <VerticalStackLayout Spacing="4">
            <Label Text="Trash"
                   Style="{StaticResource PageTitleLabel}" />
            <Label Text="Restore items or remove them permanently."
                   Style="{StaticResource MetaLabel}" />
        </VerticalStackLayout>

        <Border x:Name="StatePanel"
                Grid.Row="1"
                Padding="14"
                IsVisible="False"
                BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}"
                StrokeThickness="1">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="8" />
            </Border.StrokeShape>
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                <ActivityIndicator x:Name="LoadingIndicator"
                                   WidthRequest="20"
                                   HeightRequest="20"
                                   Color="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                <Label x:Name="StateLabel"
                       Grid.Column="1"
                       VerticalOptions="Center"
                       FontSize="13"
                       LineBreakMode="WordWrap"
                       TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
                <Button x:Name="TrashRetryButton"
                        Grid.Column="2"
                        Text="Retry"
                        IsVisible="False"
                        Style="{StaticResource SecondaryButton}"
                        Clicked="OnRefreshClicked" />
            </Grid>
        </Border>

        <CollectionView x:Name="TrashCollectionView"
                        Grid.Row="2"
                        ItemsSource="{Binding TrashItems}"
                        SelectionMode="None">
            <CollectionView.EmptyView>
                <Label Text="Trash is empty"
                       HorizontalOptions="Center"
                       VerticalOptions="Center"
                       TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:CloudDriveItem">
                    <Grid Padding="0,0,0,10">
                        <Border Padding="14"
                                BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}"
                                StrokeThickness="1">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="8" />
                            </Border.StrokeShape>
                            <Grid ColumnDefinitions="52,*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="10">
                                <Border HeightRequest="44"
                                        WidthRequest="44"
                                        BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceAltLight}, Dark={StaticResource SurfaceAltDark}}"
                                        StrokeThickness="0"
                                        VerticalOptions="Center">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="8" />
                                    </Border.StrokeShape>
                                    <Label Text="{Binding Badge}"
                                           FontAttributes="Bold"
                                           FontSize="11"
                                           TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center" />
                                </Border>
                                <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                                    <Label Text="{Binding Name}"
                                           FontAttributes="Bold"
                                           FontSize="16"
                                           TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
                                    <Label Text="{Binding Kind}"
                                           FontSize="13"
                                           TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="2"
                                                     Spacing="3"
                                                     HorizontalOptions="End"
                                                     VerticalOptions="Center">
                                    <Label Text="{Binding Size}"
                                           FontSize="13"
                                           HorizontalTextAlignment="End"
                                           TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
                                    <Label Text="{Binding ModifiedAt}"
                                           FontSize="12"
                                           HorizontalTextAlignment="End"
                                           TextColor="{AppThemeBinding Light={StaticResource TextTertiaryLight}, Dark={StaticResource TextTertiaryDark}}" />
                                </VerticalStackLayout>
                                <HorizontalStackLayout Grid.Row="1"
                                                       Grid.ColumnSpan="3"
                                                       HorizontalOptions="End"
                                                       Spacing="8">
                                    <Button Text="Restore"
                                            FontSize="12"
                                            HeightRequest="44"
                                            Padding="12,0"
                                            TextColor="White"
                                            CommandParameter="{Binding .}"
                                            Clicked="OnRestoreClicked" />
                                    <Button Text="Delete forever"
                                            FontSize="12"
                                            HeightRequest="44"
                                            Padding="12,0"
                                            Style="{StaticResource DangerButton}"
                                            CommandParameter="{Binding .}"
                                            Clicked="OnPermanentDeleteClicked" />
                                </HorizontalStackLayout>
                            </Grid>
                        </Border>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
