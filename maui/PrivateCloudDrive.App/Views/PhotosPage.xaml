<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:loc="clr-namespace:PrivateCloudDrive.App.Localization"
             xmlns:models="clr-namespace:PrivateCloudDrive.App.Models"
             xmlns:shapes="clr-namespace:Microsoft.Maui.Controls.Shapes;assembly=Microsoft.Maui.Controls"
             x:Class="PrivateCloudDrive.App.Views.PhotosPage"
             Title="{x:Static loc:AppText.MediaLibrary}"
             Shell.NavBarIsVisible="False">
    <Grid Padding="18,18,18,16"
          RowDefinitions="Auto,Auto,Auto,Auto,Auto,*"
          RowSpacing="10">
        <Grid ColumnDefinitions="*,Auto,Auto"
              ColumnSpacing="12">
            <VerticalStackLayout Spacing="4">
                <Label Style="{StaticResource PageTitleLabel}"
                       FontSize="26">
                    <Label.FormattedText>
                        <FormattedString>
                            <Span Text="我的记忆 · " />
                            <Span Text="{Binding ItemCountText}" />
                        </FormattedString>
                    </Label.FormattedText>
                </Label>
                <Label Text="按时间线整理你的照片和视频"
                       Style="{StaticResource MetaLabel}"
                       FontSize="14"
                       LineBreakMode="WordWrap" />
            </VerticalStackLayout>
            <Button x:Name="RefreshButton"
                    Grid.Column="1"
                    Text="{x:Static loc:AppText.Refresh}"
                    Style="{StaticResource SecondaryButton}"
                    Padding="14,8"
                    HeightRequest="46"
                    WidthRequest="86"
                    VerticalOptions="Center"
                    Clicked="OnRefreshClicked" />
            <Button Grid.Column="2"
                    Text="{x:Static loc:AppText.Albums}"
                    Style="{StaticResource SecondaryButton}"
                    Padding="14,8"
                    HeightRequest="46"
                    WidthRequest="86"
                    VerticalOptions="Center"
                    Clicked="OnAlbumsClicked" />
        </Grid>

        <Border Grid.Row="1"
                Padding="14"
                BackgroundColor="{StaticResource PrimarySoftLight}"
                Stroke="{StaticResource Primary}">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="22" />
            </Border.StrokeShape>
            <Grid ColumnDefinitions="Auto,*"
                  ColumnSpacing="14">
                <Border HeightRequest="50"
                        WidthRequest="50"
                        BackgroundColor="{StaticResource SurfaceLight}"
                        StrokeThickness="0"
                        VerticalOptions="Center">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="16" />
                    </Border.StrokeShape>
                    <shapes:Path Aspect="Uniform"
                                 Stroke="{StaticResource Primary}"
                                 StrokeThickness="1.9"
                                 StrokeLineCap="Round"
                                 StrokeLineJoin="Round"
                                 Data="M5,8 L23,8 L23,22 L5,22 Z M8,19 L12,15 L15,18 L17,16 L21,20 M17,12 C18.1,12 19,12.9 19,14 C19,15.1 18.1,16 17,16 C15.9,16 15,15.1 15,14 C15,12.9 15.9,12 17,12 Z"
                                 HeightRequest="30"
                                 WidthRequest="30"
                                 HorizontalOptions="Center"
                                 VerticalOptions="Center" />
                </Border>
                <VerticalStackLayout Grid.Column="1"
                                     Spacing="3"
                                     VerticalOptions="Center">
                    <Label Text="AI 精选记忆"
                           FontFamily="OpenSansSemibold"
                           FontSize="22"
                           TextColor="{StaticResource TextPrimaryLight}" />
                    <Label Text="已为你聚合最近上传、人物和地点线索，继续滚动查看全部时间线。"
                           Style="{StaticResource MetaLabel}"
                           LineBreakMode="WordWrap" />
                </VerticalStackLayout>
            </Grid>
        </Border>

        <Border Grid.Row="2"
                Padding="14"
                IsVisible="{Binding IsProcessingEntryVisible}"
                BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}"
                Stroke="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="10" />
            </Border.StrokeShape>
            <Grid ColumnDefinitions="*,Auto"
                  ColumnSpacing="12">
                <VerticalStackLayout Spacing="3"
                                     VerticalOptions="Center">
                    <Label Text="{Binding ProcessingStatusTitle}"
                           FontFamily="OpenSansSemibold"
                           FontSize="15"
                           TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
                    <Label Text="{Binding ProcessingStatusDescription}"
                           Style="{StaticResource MetaLabel}"
                           LineBreakMode="WordWrap" />
                </VerticalStackLayout>
                <Button x:Name="ProcessingButton"
                        Grid.Column="1"
                        Text="{Binding ProcessingStatusEntryText}"
                        Style="{StaticResource SecondaryButton}"
                        Padding="12,8"
                        HeightRequest="42"
                        MinimumWidthRequest="96"
                        VerticalOptions="Center"
                        Clicked="OnProcessingClicked" />
            </Grid>
        </Border>

        <Border Grid.Row="3"
                Padding="7"
                BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}"
                Stroke="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="10" />
            </Border.StrokeShape>
            <Grid ColumnDefinitions="*,*,*"
                  ColumnSpacing="8">
                <Button x:Name="AllMediaButton"
                        Text="全部"
                        Style="{StaticResource SegmentButtonSelected}"
                        Clicked="OnAllMediaClicked" />
                <Button x:Name="ImagesButton"
                        Grid.Column="1"
                        Text="{x:Static loc:AppText.Photos}"
                        Style="{StaticResource SegmentButton}"
                        Clicked="OnImagesClicked" />
                <Button x:Name="VideosButton"
                        Grid.Column="2"
                        Text="{x:Static loc:AppText.Videos}"
                        Style="{StaticResource SegmentButton}"
                        Clicked="OnVideosClicked" />
            </Grid>
        </Border>

        <Border x:Name="PhotosStatePanel"
                Grid.Row="4"
                Padding="14"
                IsVisible="False"
                BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}"
                Stroke="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="10" />
            </Border.StrokeShape>
            <Grid ColumnDefinitions="Auto,*,Auto"
                  ColumnSpacing="10">
                <ActivityIndicator x:Name="PhotosLoadingIndicator"
                                   WidthRequest="20"
                                   HeightRequest="20"
                                   Color="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                <Label x:Name="PhotosStateLabel"
                       Grid.Column="1"
                       VerticalOptions="Center"
                       FontSize="13"
                       LineBreakMode="WordWrap"
                       TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
                <Button x:Name="PhotosRetryButton"
                        Grid.Column="2"
                        Text="{x:Static loc:AppText.Retry}"
                        IsVisible="False"
                        Style="{StaticResource SecondaryButton}"
                        Padding="12,6"
                        MinimumHeightRequest="36"
                        Clicked="OnRetryClicked" />
            </Grid>
        </Border>

        <CollectionView x:Name="PhotosCollectionView"
                        Grid.Row="5"
                        ItemsSource="{Binding TimelineGroups}"
                        IsGrouped="True"
                        SelectionMode="Single"
                        SelectionChanged="OnPhotoSelected">
            <CollectionView.ItemsLayout>
                <GridItemsLayout Orientation="Vertical"
                                 Span="3"
                                 HorizontalItemSpacing="8"
                                 VerticalItemSpacing="10" />
            </CollectionView.ItemsLayout>
            <CollectionView.GroupHeaderTemplate>
                <DataTemplate x:DataType="models:MediaTimelineGroup">
                    <Grid Padding="0,10,0,6"
                          ColumnDefinitions="*,Auto">
                        <Label Text="{Binding Name}"
                               Style="{StaticResource SectionTitleLabel}" />
                        <Label Grid.Column="1"
                               Text="{Binding CountText}"
                               Style="{StaticResource MetaLabel}"
                               VerticalOptions="Center" />
                    </Grid>
                </DataTemplate>
            </CollectionView.GroupHeaderTemplate>
            <CollectionView.EmptyView>
                <Border Padding="20"
                        BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}"
                        VerticalOptions="Start"
                        HeightRequest="220"
                        Stroke="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="10" />
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="10"
                                         HorizontalOptions="Center"
                                         VerticalOptions="Center">
                        <Border HeightRequest="54"
                                WidthRequest="54"
                                BackgroundColor="{AppThemeBinding Light={StaticResource PrimarySoftLight}, Dark={StaticResource PrimarySoftDark}}"
                                StrokeThickness="0"
                                HorizontalOptions="Center">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12" />
                            </Border.StrokeShape>
                            <shapes:Path Aspect="Uniform"
                                         Stroke="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                                         StrokeThickness="1.9"
                                         StrokeLineCap="Round"
                                         StrokeLineJoin="Round"
                                         Data="M5,8 L23,8 L23,22 L5,22 Z M8,19 L12,15 L15,18 L17,16 L21,20"
                                         HeightRequest="28"
                                         WidthRequest="28"
                                         HorizontalOptions="Center"
                                         VerticalOptions="Center" />
                        </Border>
                        <Label Text="暂无媒体"
                               Style="{StaticResource SectionTitleLabel}"
                               HorizontalTextAlignment="Center" />
                        <Label Text="上传图片或视频后，会按时间线显示在这里。"
                               Style="{StaticResource MetaLabel}"
                               HorizontalTextAlignment="Center"
                               LineBreakMode="WordWrap" />
                    </VerticalStackLayout>
                </Border>
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:MediaLibraryItem">
                    <Border BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}"
                            Stroke="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="10" />
                        </Border.StrokeShape>
                        <Grid RowDefinitions="112,Auto">
                            <Grid BackgroundColor="{AppThemeBinding Light={StaticResource PrimarySoftLight}, Dark={StaticResource PrimarySoftDark}}">
                                <Image Source="{Binding ThumbnailSource}"
                                       Aspect="AspectFill"
                                       IsVisible="{Binding HasThumbnail}" />
                                <Label Text="{Binding Badge}"
                                       IsVisible="{Binding ShowBadge}"
                                       FontFamily="OpenSansSemibold"
                                       FontSize="13"
                                       TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center" />
                                <Grid Padding="7">
                                    <Border HorizontalOptions="End"
                                            VerticalOptions="Start"
                                            Padding="6,2"
                                            IsVisible="{Binding ShowProcessStatus}"
                                            BackgroundColor="{StaticResource Danger}"
                                            StrokeThickness="0">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="8" />
                                        </Border.StrokeShape>
                                        <Label Text="{Binding ProcessStatusText}"
                                               FontSize="10"
                                               TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
                                    </Border>
                                    <Border HorizontalOptions="End"
                                            VerticalOptions="End"
                                            Padding="6,2"
                                            IsVisible="{Binding ShowVideoDuration}"
                                            BackgroundColor="#99000000"
                                            StrokeThickness="0">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="8" />
                                        </Border.StrokeShape>
                                        <Label Text="{Binding DurationText}"
                                               FontSize="10"
                                               TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
                                    </Border>
                                    <Border HorizontalOptions="Start"
                                            VerticalOptions="End"
                                            Padding="6,2"
                                            IsVisible="{Binding IsVideo}"
                                            BackgroundColor="#99000000"
                                            StrokeThickness="0">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="8" />
                                        </Border.StrokeShape>
                                        <Label Text="{x:Static loc:AppText.Videos}"
                                               FontSize="10"
                                               TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
                                    </Border>
                                </Grid>
                            </Grid>
                            <VerticalStackLayout Grid.Row="1"
                                                 Padding="8,7,8,8"
                                                 Spacing="1">
                                <Label Text="{Binding Name}"
                                       FontFamily="OpenSansSemibold"
                                       FontSize="12"
                                       LineBreakMode="TailTruncation" />
                                <Label Text="{Binding TimelineMetaText}"
                                       FontSize="11"
                                       TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}"
                                       LineBreakMode="TailTruncation" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
