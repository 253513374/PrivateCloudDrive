<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:loc="clr-namespace:PrivateCloudDrive.App.Localization"
             xmlns:models="clr-namespace:PrivateCloudDrive.App.Models"
             x:Class="PrivateCloudDrive.App.Views.PhotosPage"
             Title="媒体库"
             Shell.NavBarIsVisible="False">
    <Grid Padding="18" RowDefinitions="Auto,Auto,Auto,*" RowSpacing="14">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <VerticalStackLayout Spacing="4">
                <Label Text="媒体库" Style="{StaticResource PageTitleLabel}" />
                <Label Text="{Binding ItemCountText}" Style="{StaticResource MetaLabel}" />
            </VerticalStackLayout>
            <Button x:Name="RefreshButton"
                    Grid.Column="1"
                    Text="{x:Static loc:AppText.Refresh}"
                    TextColor="White"
                    VerticalOptions="Center"
                    Clicked="OnRefreshClicked" />
        </Grid>

        <HorizontalStackLayout Grid.Row="1" Spacing="8">
            <Button x:Name="AllMediaButton"
                    Text="全部"
                    Style="{StaticResource SecondaryButton}"
                    Clicked="OnAllMediaClicked" />
            <Button x:Name="ImagesButton"
                    Text="图片"
                    Style="{StaticResource SecondaryButton}"
                    Clicked="OnImagesClicked" />
            <Button x:Name="VideosButton"
                    Text="视频"
                    Style="{StaticResource SecondaryButton}"
                    Clicked="OnVideosClicked" />
            <Button Text="相册"
                    Style="{StaticResource SecondaryButton}"
                    Clicked="OnAlbumsClicked" />
            <Button Text="处理状态"
                    Style="{StaticResource SecondaryButton}"
                    Clicked="OnProcessingClicked" />
        </HorizontalStackLayout>

        <Border x:Name="PhotosStatePanel"
                Grid.Row="2"
                Padding="14"
                IsVisible="False"
                BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}"
                StrokeThickness="1">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="8" />
            </Border.StrokeShape>
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                <ActivityIndicator x:Name="PhotosLoadingIndicator"
                                   WidthRequest="20"
                                   HeightRequest="20"
                                   Color="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                <Label x:Name="PhotosStateLabel"
                       Grid.Column="1"
                       VerticalOptions="Center"
                       FontSize="13"
                       LineBreakMode="WordWrap"
                       TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
                <Button x:Name="PhotosRetryButton"
                        Grid.Column="2"
                        Text="{x:Static loc:AppText.Retry}"
                        IsVisible="False"
                        Style="{StaticResource SecondaryButton}"
                        Clicked="OnRetryClicked" />
            </Grid>
        </Border>

        <CollectionView x:Name="PhotosCollectionView"
                        Grid.Row="3"
                        ItemsSource="{Binding TimelineGroups}"
                        IsGrouped="True"
                        SelectionMode="Single"
                        SelectionChanged="OnPhotoSelected">
            <CollectionView.ItemsLayout>
                <GridItemsLayout Orientation="Vertical" Span="3" HorizontalItemSpacing="8" VerticalItemSpacing="8" />
            </CollectionView.ItemsLayout>
            <CollectionView.GroupHeaderTemplate>
                <DataTemplate x:DataType="models:MediaTimelineGroup">
                    <Grid Padding="0,8,0,6" ColumnDefinitions="*,Auto">
                        <Label Text="{Binding Name}" FontAttributes="Bold" FontSize="15" />
                        <Label Grid.Column="1" Text="{Binding CountText}" Style="{StaticResource MetaLabel}" />
                    </Grid>
                </DataTemplate>
            </CollectionView.GroupHeaderTemplate>
            <CollectionView.EmptyView>
                <Border Padding="18"
                        BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}"
                        StrokeThickness="1">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="8" />
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="6" HorizontalOptions="Center" VerticalOptions="Center">
                        <Label Text="{x:Static loc:AppText.NoPhotosFound}" Style="{StaticResource SectionTitleLabel}" HorizontalTextAlignment="Center" />
                        <Label Text="{x:Static loc:AppText.NoPhotosHelp}" Style="{StaticResource MetaLabel}" HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </Border>
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:MediaLibraryItem">
                    <Border StrokeThickness="1"
                            BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="8" />
                        </Border.StrokeShape>
                        <Grid HeightRequest="118"
                              BackgroundColor="{AppThemeBinding Light={StaticResource PrimarySoftLight}, Dark={StaticResource PrimarySoftDark}}">
                            <Image Source="{Binding ThumbnailSource}"
                                   Aspect="AspectFill"
                                   IsVisible="{Binding HasThumbnail}" />
                            <Grid Padding="8" RowDefinitions="*,Auto">
                                <Label Text="{Binding Badge}"
                                       IsVisible="{Binding ShowBadge}"
                                       FontAttributes="Bold"
                                       FontSize="14"
                                       TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                                <Label Grid.Row="1"
                                       Text="{Binding Name}"
                                       FontSize="12"
                                       LineBreakMode="TailTruncation"
                                       TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
                                <Border Grid.Row="0"
                                        HorizontalOptions="End"
                                        VerticalOptions="Start"
                                        Padding="6,2"
                                        IsVisible="{Binding ShowProcessStatus}"
                                        BackgroundColor="{StaticResource Danger}"
                                        StrokeThickness="0">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="8" />
                                    </Border.StrokeShape>
                                    <Label Text="{Binding ProcessStatusText}"
                                           FontSize="10"
                                           TextColor="White" />
                                </Border>
                            </Grid>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
