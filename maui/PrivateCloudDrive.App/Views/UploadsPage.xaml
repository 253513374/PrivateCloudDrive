<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:loc="clr-namespace:PrivateCloudDrive.App.Localization"
             xmlns:models="clr-namespace:PrivateCloudDrive.App.Models"
             xmlns:shapes="clr-namespace:Microsoft.Maui.Controls.Shapes;assembly=Microsoft.Maui.Controls"
             x:Class="PrivateCloudDrive.App.Views.UploadsPage"
             Title="{x:Static loc:AppText.Uploads}"
             Shell.NavBarIsVisible="False">
    <Grid Padding="18,18,18,16"
          RowDefinitions="Auto,Auto,*"
          RowSpacing="10">
        <VerticalStackLayout Spacing="4">
            <Label Text="备份队列"
                   Style="{StaticResource PageTitleLabel}"
                   FontSize="26" />
            <Label Text="照片、文件备份的等待、上传、失败和完成状态"
                   Style="{StaticResource MetaLabel}"
                   FontSize="14"
                   LineBreakMode="WordWrap" />
        </VerticalStackLayout>

        <Border x:Name="QueueStatePanel"
                Grid.Row="1"
                Padding="14"
                BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}"
                Stroke="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="10" />
            </Border.StrokeShape>
            <Grid ColumnDefinitions="Auto,*,Auto"
                  ColumnSpacing="14">
                <Border HeightRequest="50"
                        WidthRequest="50"
                        BackgroundColor="{AppThemeBinding Light={StaticResource PrimarySoftLight}, Dark={StaticResource PrimarySoftDark}}"
                        StrokeThickness="0"
                        VerticalOptions="Center">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12" />
                    </Border.StrokeShape>
                    <shapes:Path Aspect="Uniform"
                                 Stroke="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                                 StrokeThickness="1.9"
                                 StrokeLineCap="Round"
                                 StrokeLineJoin="Round"
                                 Data="M14,5 L14,19 M9,10 L14,5 L19,10 M6,23 L22,23"
                                 HeightRequest="30"
                                 WidthRequest="30"
                                 HorizontalOptions="Center"
                                 VerticalOptions="Center" />
                </Border>
                <VerticalStackLayout Grid.Column="1"
                                     Spacing="3"
                                     VerticalOptions="Center">
                    <Label Text="当前备份队列"
                           FontFamily="OpenSansSemibold"
                           FontSize="22"
                           TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
                    <Label x:Name="QueueStateLabel"
                           Style="{StaticResource MetaLabel}"
                           LineBreakMode="WordWrap" />
                </VerticalStackLayout>
                <Button x:Name="ClearCompletedButton"
                        Grid.Column="2"
                        Text="清理完成"
                        Style="{StaticResource SecondaryButton}"
                        Padding="12,8"
                        HeightRequest="44"
                        WidthRequest="128"
                        VerticalOptions="Center"
                        Clicked="OnClearCompletedClicked" />
            </Grid>
        </Border>

        <CollectionView Grid.Row="2"
                        ItemsSource="{Binding UploadItems}">
            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical"
                                   ItemSpacing="10" />
            </CollectionView.ItemsLayout>
            <CollectionView.EmptyView>
                <Border Padding="20"
                        VerticalOptions="Start"
                        HeightRequest="220"
                        BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}"
                        Stroke="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="10" />
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="10"
                                         HorizontalOptions="Center"
                                         VerticalOptions="Center">
                        <Border HeightRequest="54"
                                WidthRequest="54"
                                BackgroundColor="{AppThemeBinding Light={StaticResource PrimarySoftLight}, Dark={StaticResource PrimarySoftDark}}"
                                StrokeThickness="0"
                                HorizontalOptions="Center">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12" />
                            </Border.StrokeShape>
                            <shapes:Path Aspect="Uniform"
                                         Stroke="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                                         StrokeThickness="1.9"
                                         StrokeLineCap="Round"
                                         StrokeLineJoin="Round"
                                         Data="M14,5 L14,19 M9,10 L14,5 L19,10 M6,23 L22,23"
                                         HeightRequest="28"
                                         WidthRequest="28"
                                         HorizontalOptions="Center"
                                         VerticalOptions="Center" />
                        </Border>
                        <Label Text="{x:Static loc:AppText.NoUploadTasks}"
                               Style="{StaticResource SectionTitleLabel}"
                               HorizontalTextAlignment="Center" />
                        <Label Text="从文件页选择照片或文件备份后，进度会显示在这里；失败任务可用于诊断和重试。"
                               Style="{StaticResource MetaLabel}"
                               HorizontalTextAlignment="Center"
                               LineBreakMode="WordWrap" />
                        <Button Text="去文件页备份"
                                FontFamily="OpenSansSemibold"
                                Padding="18,8"
                                HeightRequest="42"
                                HorizontalOptions="Center"
                                Clicked="OnGoToFilesClicked" />
                    </VerticalStackLayout>
                </Border>
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:UploadQueueItem">
                    <Border Padding="14"
                            BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}"
                            Stroke="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="10" />
                        </Border.StrokeShape>
                        <Grid ColumnDefinitions="Auto,*"
                              ColumnSpacing="14"
                              RowDefinitions="Auto,Auto,Auto">
                            <Border HeightRequest="48"
                                    WidthRequest="48"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource PrimarySoftLight}, Dark={StaticResource PrimarySoftDark}}"
                                    StrokeThickness="0"
                                    VerticalOptions="Start">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="10" />
                                </Border.StrokeShape>
                                <shapes:Path Aspect="Uniform"
                                             Stroke="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                                             StrokeThickness="1.8"
                                             StrokeLineCap="Round"
                                             StrokeLineJoin="Round"
                                             Data="M14,6 L14,18 M10,10 L14,6 L18,10 M7,23 L21,23"
                                             HeightRequest="26"
                                             WidthRequest="26"
                                             HorizontalOptions="Center"
                                             VerticalOptions="Center" />
                            </Border>
                            <Grid Grid.Column="1"
                                  ColumnDefinitions="*,Auto"
                                  ColumnSpacing="10">
                                <VerticalStackLayout Spacing="3">
                                    <Label Text="{Binding FileName}"
                                           FontFamily="OpenSansSemibold"
                                           FontSize="16"
                                           TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}"
                                           LineBreakMode="TailTruncation" />
                                    <Label Text="{Binding TargetPath}"
                                           Style="{StaticResource MetaLabel}"
                                           LineBreakMode="TailTruncation" />
                                </VerticalStackLayout>
                                <Border Grid.Column="1"
                                        Padding="9,5"
                                        BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceAltLight}, Dark={StaticResource SurfaceAltDark}}"
                                        StrokeThickness="0"
                                        VerticalOptions="Start">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="14" />
                                    </Border.StrokeShape>
                                    <Label Text="{Binding StatusText}"
                                           FontFamily="OpenSansSemibold"
                                           FontSize="12"
                                           TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                                </Border>
                            </Grid>
                            <Grid Grid.Row="1"
                                  Grid.Column="1"
                                  Margin="0,10,0,0"
                                  ColumnDefinitions="*,Auto"
                                  ColumnSpacing="10">
                                <ProgressBar Progress="{Binding Progress}"
                                             HeightRequest="6"
                                             VerticalOptions="Center" />
                                <Label Grid.Column="1"
                                       Text="{Binding ProgressText}"
                                       FontFamily="OpenSansSemibold"
                                       FontSize="12"
                                       TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}"
                                       VerticalOptions="Center" />
                            </Grid>
                            <VerticalStackLayout Grid.Row="2"
                                                 Grid.Column="1"
                                                 Margin="0,8,0,0"
                                                 Spacing="4">
                                <Label Text="{Binding ErrorMessage}"
                                       IsVisible="{Binding IsFailed}"
                                       FontSize="12"
                                       TextColor="{StaticResource Danger}"
                                       LineBreakMode="WordWrap" />
                                <Label Text="{Binding FailureHint}"
                                       IsVisible="{Binding IsFailed}"
                                       FontSize="12"
                                       TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}"
                                       LineBreakMode="WordWrap" />
                                <Button Text="重试备份"
                                        IsVisible="{Binding CanRetry}"
                                        Style="{StaticResource SecondaryButton}"
                                        Padding="14,6"
                                        HeightRequest="38"
                                        HorizontalOptions="Start"
                                        Clicked="OnRetryBackupClicked" />
                                <Label Text="{Binding CompletedAtText}"
                                       IsVisible="{Binding IsCompleted}"
                                       FontSize="12"
                                       TextColor="{StaticResource Success}" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
