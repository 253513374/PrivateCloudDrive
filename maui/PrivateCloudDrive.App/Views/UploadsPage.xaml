<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:loc="clr-namespace:PrivateCloudDrive.App.Localization"
             xmlns:models="clr-namespace:PrivateCloudDrive.App.Models"
             x:Class="PrivateCloudDrive.App.Views.UploadsPage"
             Title="{x:Static loc:AppText.Uploads}"
             Shell.NavBarIsVisible="False">
    <Grid Padding="18" RowDefinitions="Auto,Auto,*" RowSpacing="16">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <VerticalStackLayout Spacing="4">
                <Label Text="{x:Static loc:AppText.Uploads}" Style="{StaticResource PageTitleLabel}" />
                <Label Text="{x:Static loc:AppText.ActiveFailedCompletedUploads}" Style="{StaticResource MetaLabel}" />
            </VerticalStackLayout>
            <Button Grid.Column="1"
                    Text="{x:Static loc:AppText.ClearDone}"
                    Style="{StaticResource SecondaryButton}"
                    VerticalOptions="Center"
                    Clicked="OnClearCompletedClicked" />
        </Grid>

        <Border x:Name="QueueStatePanel"
                Grid.Row="1"
                Padding="14"
                BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}"
                StrokeThickness="1">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="8" />
            </Border.StrokeShape>
            <Label x:Name="QueueStateLabel"
                   FontSize="13"
                   TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
        </Border>

        <CollectionView Grid.Row="2"
                        ItemsSource="{Binding UploadItems}"
                        SelectionMode="None">
            <CollectionView.EmptyView>
                <Border Padding="18"
                        BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}"
                        StrokeThickness="1">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="8" />
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="10"
                                         HorizontalOptions="Center"
                                         VerticalOptions="Center">
                        <Label Text="{x:Static loc:AppText.NoUploadTasks}"
                               Style="{StaticResource SectionTitleLabel}"
                               HorizontalTextAlignment="Center" />
                        <Label Text="{x:Static loc:AppText.NoUploadTasksHelp}"
                               Style="{StaticResource MetaLabel}"
                               HorizontalTextAlignment="Center"
                               MaximumWidthRequest="320"
                               LineBreakMode="WordWrap" />
                    </VerticalStackLayout>
                </Border>
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:UploadQueueItem">
                    <Grid Padding="0,0,0,10">
                        <Border Padding="14"
                                BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}"
                                StrokeThickness="1">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="8" />
                            </Border.StrokeShape>
                            <Grid RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="8">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                    <VerticalStackLayout Spacing="3">
                                        <Label Text="{Binding FileName}"
                                               FontAttributes="Bold"
                                               FontSize="15"
                                               LineBreakMode="TailTruncation"
                                               TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
                                        <Label Text="{Binding TargetPath}"
                                               Style="{StaticResource MetaLabel}"
                                               LineBreakMode="TailTruncation" />
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Grid.Column="1"
                                                         Spacing="3"
                                                         HorizontalOptions="End">
                                        <Label Text="{Binding StatusText}"
                                               FontAttributes="Bold"
                                               FontSize="13"
                                               HorizontalTextAlignment="End"
                                               TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
                                        <Label Text="{Binding ProgressText}"
                                               Style="{StaticResource MetaLabel}"
                                               HorizontalTextAlignment="End" />
                                    </VerticalStackLayout>
                                </Grid>

                                <ProgressBar Grid.Row="1"
                                             Progress="{Binding Progress}"
                                             ProgressColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />

                                <Label Grid.Row="2"
                                       Text="{Binding ErrorMessage}"
                                       IsVisible="{Binding IsFailed}"
                                       FontSize="13"
                                       LineBreakMode="WordWrap"
                                       TextColor="{StaticResource Danger}" />

                                <Label Grid.Row="3"
                                       Text="{x:Static loc:AppText.Completed}"
                                       IsVisible="{Binding IsCompleted}"
                                       FontSize="13"
                                       TextColor="{StaticResource Success}" />
                            </Grid>
                        </Border>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
