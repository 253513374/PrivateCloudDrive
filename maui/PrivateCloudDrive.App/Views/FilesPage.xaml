<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:loc="clr-namespace:PrivateCloudDrive.App.Localization"
             xmlns:models="clr-namespace:PrivateCloudDrive.App.Models"
             xmlns:shapes="clr-namespace:Microsoft.Maui.Controls.Shapes;assembly=Microsoft.Maui.Controls"
             x:Class="PrivateCloudDrive.App.Views.FilesPage"
             Title="{x:Static loc:AppText.Files}"
             Shell.NavBarIsVisible="False">
    <ContentPage.Resources>
        <Style TargetType="Border" x:Key="FilesPanel">
            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}" />
            <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}" />
            <Setter Property="StrokeThickness" Value="2" />
            <Setter Property="Padding" Value="14" />
        </Style>

        <Style TargetType="Border" x:Key="FilesField">
            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource SurfaceAltLight}, Dark={StaticResource SurfaceAltDark}}" />
            <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}" />
            <Setter Property="StrokeThickness" Value="1.5" />
            <Setter Property="Padding" Value="10,0" />
        </Style>
    </ContentPage.Resources>

    <Grid Padding="16,12,16,12"
          RowDefinitions="Auto,Auto,Auto,*"
          RowSpacing="8">
        <Grid ColumnDefinitions="*,Auto,Auto"
              ColumnSpacing="8">
            <VerticalStackLayout Spacing="2"
                                 VerticalOptions="Center">
                <Label Text="{x:Static loc:AppText.Files}"
                       Style="{StaticResource PageTitleLabel}"
                       FontSize="26" />
                <Label Text="安全管理你的私有文件、媒体和文件夹"
                       Style="{StaticResource MetaLabel}"
                       FontSize="13"
                       LineBreakMode="TailTruncation" />
            </VerticalStackLayout>

            <Button x:Name="RefreshButton"
                    Grid.Column="1"
                    Text="{x:Static loc:AppText.Refresh}"
                    Style="{StaticResource SecondaryButton}"
                    FontFamily="OpenSansSemibold"
                    FontSize="13"
                    Padding="10,6"
                    HeightRequest="38"
                    MinimumWidthRequest="64"
                    VerticalOptions="Center"
                    Clicked="OnRefreshClicked" />

            <Button x:Name="SelectionModeButton"
                    Grid.Column="2"
                    Text="选择"
                    Style="{StaticResource SecondaryButton}"
                    FontFamily="OpenSansSemibold"
                    FontSize="13"
                    Padding="10,6"
                    HeightRequest="38"
                    MinimumWidthRequest="64"
                    VerticalOptions="Center"
                    Clicked="OnToggleSelectionModeClicked" />
        </Grid>

        <Border Grid.Row="1"
                Style="{StaticResource FilesPanel}"
                Padding="10">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="12" />
            </Border.StrokeShape>
            <Grid RowDefinitions="Auto,Auto,Auto"
                  RowSpacing="8">
                <Grid ColumnDefinitions="Auto,*,Auto"
                      ColumnSpacing="10">
                    <Border HeightRequest="34"
                            WidthRequest="34"
                            BackgroundColor="{AppThemeBinding Light={StaticResource PrimarySoftLight}, Dark={StaticResource PrimarySoftDark}}"
                            Stroke="{AppThemeBinding Light={StaticResource DoodleInk}, Dark={StaticResource BorderDark}}"
                            StrokeThickness="1.5"
                            VerticalOptions="Center">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="10" />
                        </Border.StrokeShape>
                        <shapes:Path Aspect="Uniform"
                                     Stroke="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextPrimaryDark}}"
                                     StrokeThickness="2"
                                     StrokeLineCap="Round"
                                     StrokeLineJoin="Round"
                                     Data="M4,9 L11,9 L13,12 L24,12 L24,24 L4,24 Z M4,9 L4,24 M8,16 L20,16"
                                     HeightRequest="22"
                                     WidthRequest="22"
                                     HorizontalOptions="Center"
                                     VerticalOptions="Center" />
                    </Border>

                    <VerticalStackLayout Grid.Column="1"
                                         Spacing="0"
                                         VerticalOptions="Center">
                        <Label Text="{Binding CurrentPath}"
                               FontFamily="OpenSansSemibold"
                               FontSize="16"
                               TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}"
                               LineBreakMode="TailTruncation" />
                        <Label Text="{Binding ItemCountText}"
                               Style="{StaticResource MetaLabel}"
                               FontSize="12"
                               LineBreakMode="TailTruncation" />
                    </VerticalStackLayout>

                    <Button x:Name="BackButton"
                            Grid.Column="2"
                            Text="返回"
                            IsVisible="{Binding CanGoBack}"
                            Style="{StaticResource SecondaryButton}"
                            FontFamily="OpenSansSemibold"
                            FontSize="13"
                            Padding="10,5"
                            HeightRequest="34"
                            MinimumWidthRequest="62"
                            VerticalOptions="Center"
                            Clicked="OnBackClicked" />
                </Grid>

                <Border Grid.Row="1"
                        Style="{StaticResource FilesField}">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12" />
                    </Border.StrokeShape>
                    <SearchBar x:Name="FilesSearchBar"
                               Placeholder="搜索文件、文件夹或媒体"
                               HeightRequest="40"
                               SearchButtonPressed="OnSearchPressed"
                               TextChanged="OnSearchTextChanged" />
                </Border>

                <ScrollView Grid.Row="2"
                            Orientation="Horizontal"
                            HorizontalScrollBarVisibility="Never">
                    <HorizontalStackLayout Spacing="8">
                        <Border Style="{StaticResource FilesField}"
                                WidthRequest="118">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12" />
                            </Border.StrokeShape>
                            <Picker x:Name="TypeFilterPicker"
                                    Title="类型"
                                    HeightRequest="38"
                                    SelectedIndexChanged="OnFilterChanged" />
                        </Border>

                        <Border Style="{StaticResource FilesField}"
                                WidthRequest="118">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12" />
                            </Border.StrokeShape>
                            <Picker x:Name="MediaFilterPicker"
                                    Title="媒体"
                                    HeightRequest="38"
                                    SelectedIndexChanged="OnFilterChanged" />
                        </Border>

                        <Border Style="{StaticResource FilesField}"
                                WidthRequest="142">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12" />
                            </Border.StrokeShape>
                            <Picker x:Name="SortPicker"
                                    Title="排序"
                                    HeightRequest="38"
                                    SelectedIndexChanged="OnFilterChanged" />
                        </Border>

                        <Border Padding="10,0"
                                BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceAltDark}}"
                                Stroke="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}"
                                StrokeThickness="1.5">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12" />
                            </Border.StrokeShape>
                            <HorizontalStackLayout Spacing="8"
                                                   HeightRequest="38"
                                                   VerticalOptions="Center">
                                <Switch x:Name="SearchAllSwitch"
                                        VerticalOptions="Center"
                                        Toggled="OnFilterChanged" />
                                <Label Text="全局搜索"
                                       Style="{StaticResource MetaLabel}"
                                       VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </Border>

                        <Button Text="清除"
                                Style="{StaticResource SecondaryButton}"
                                FontFamily="OpenSansSemibold"
                                FontSize="13"
                                Padding="10,6"
                                HeightRequest="38"
                                MinimumWidthRequest="64"
                                Clicked="OnClearFiltersClicked" />
                    </HorizontalStackLayout>
                </ScrollView>
            </Grid>
        </Border>

        <VerticalStackLayout Grid.Row="2"
                             Spacing="7">
            <Grid ColumnDefinitions="*,*"
                  ColumnSpacing="10">
                <Button Text="{x:Static loc:AppText.Upload}"
                        FontFamily="OpenSansSemibold"
                        FontSize="15"
                        HeightRequest="42"
                        Clicked="OnUploadClicked" />
                <Button Grid.Column="1"
                        Text="{x:Static loc:AppText.NewFolder}"
                        Style="{StaticResource SecondaryButton}"
                        FontFamily="OpenSansSemibold"
                        FontSize="15"
                        HeightRequest="42"
                        Clicked="OnNewFolderClicked" />
            </Grid>

            <Border x:Name="BatchToolbar"
                    Padding="10"
                    IsVisible="False"
                    BackgroundColor="{AppThemeBinding Light={StaticResource PrimarySoftLight}, Dark={StaticResource PrimarySoftDark}}"
                    Stroke="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}"
                    StrokeThickness="2">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12" />
                </Border.StrokeShape>
                <Grid RowDefinitions="Auto,Auto"
                      RowSpacing="8">
                    <Label x:Name="SelectedCountLabel"
                           Style="{StaticResource SectionTitleLabel}"
                           FontSize="17" />
                    <ScrollView Grid.Row="1"
                                Orientation="Horizontal"
                                HorizontalScrollBarVisibility="Never">
                        <HorizontalStackLayout Spacing="8">
                            <Button x:Name="BatchMoveRootButton"
                                    Text="移至根目录"
                                    Style="{StaticResource SecondaryButton}"
                                    FontFamily="OpenSansSemibold"
                                    Padding="10,7"
                                    FontSize="13"
                                    MinimumHeightRequest="36"
                                    Clicked="OnBatchMoveRootClicked" />
                            <Button Text="收藏"
                                    Style="{StaticResource SecondaryButton}"
                                    FontFamily="OpenSansSemibold"
                                    Padding="10,7"
                                    FontSize="13"
                                    MinimumHeightRequest="36"
                                    Clicked="OnBatchFavoriteClicked" />
                            <Button Text="取消收藏"
                                    Style="{StaticResource SecondaryButton}"
                                    FontFamily="OpenSansSemibold"
                                    Padding="10,7"
                                    FontSize="13"
                                    MinimumHeightRequest="36"
                                    Clicked="OnBatchUnfavoriteClicked" />
                            <Button Text="移入回收站"
                                    Style="{StaticResource DangerButton}"
                                    FontFamily="OpenSansSemibold"
                                    Padding="10,7"
                                    FontSize="13"
                                    MinimumHeightRequest="36"
                                    Clicked="OnBatchDeleteClicked" />
                        </HorizontalStackLayout>
                    </ScrollView>
                </Grid>
            </Border>

            <Border x:Name="UploadStatusPanel"
                    Padding="10"
                    IsVisible="False"
                    BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}"
                    Stroke="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}"
                    StrokeThickness="2">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12" />
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="8">
                    <Label x:Name="UploadStatusLabel"
                           Style="{StaticResource MetaLabel}"
                           LineBreakMode="TailTruncation" />
                    <ProgressBar x:Name="UploadProgressBar"
                                 Progress="0"
                                 HeightRequest="6" />
                </VerticalStackLayout>
            </Border>

            <Border x:Name="FilesStatePanel"
                    Padding="10"
                    IsVisible="False"
                    BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}"
                    Stroke="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}"
                    StrokeThickness="2">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12" />
                </Border.StrokeShape>
                <Grid ColumnDefinitions="Auto,*,Auto"
                      ColumnSpacing="10">
                    <ActivityIndicator x:Name="FilesLoadingIndicator"
                                       WidthRequest="20"
                                       HeightRequest="20"
                                       VerticalOptions="Center" />
                    <Label x:Name="FilesStateLabel"
                           Grid.Column="1"
                           Style="{StaticResource MetaLabel}"
                           VerticalOptions="Center"
                           LineBreakMode="WordWrap" />
                    <Button x:Name="FilesRetryButton"
                            Grid.Column="2"
                            Text="{x:Static loc:AppText.Retry}"
                            IsVisible="False"
                            Style="{StaticResource SecondaryButton}"
                            FontFamily="OpenSansSemibold"
                            Padding="12,6"
                            MinimumHeightRequest="36"
                            Clicked="OnRetryLoadClicked" />
                </Grid>
            </Border>
        </VerticalStackLayout>

        <CollectionView x:Name="FilesCollectionView"
                        Grid.Row="3"
                        ItemsSource="{Binding Items}"
                        SelectionMode="Single"
                        SelectionChanged="OnFileSelected">
            <CollectionView.EmptyView>
                <Border Padding="24"
                        VerticalOptions="Start"
                        HeightRequest="230"
                        BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}"
                        Stroke="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}"
                        StrokeThickness="2">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12" />
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="12"
                                         HorizontalOptions="Center"
                                         VerticalOptions="Center">
                        <Border HeightRequest="56"
                                WidthRequest="56"
                                BackgroundColor="{AppThemeBinding Light={StaticResource PrimarySoftLight}, Dark={StaticResource PrimarySoftDark}}"
                                Stroke="{AppThemeBinding Light={StaticResource DoodleInk}, Dark={StaticResource BorderDark}}"
                                StrokeThickness="2"
                                HorizontalOptions="Center">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="14" />
                            </Border.StrokeShape>
                            <shapes:Path Aspect="Uniform"
                                         Stroke="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextPrimaryDark}}"
                                         StrokeThickness="2"
                                         StrokeLineCap="Round"
                                         StrokeLineJoin="Round"
                                         Data="M6,10 L12,10 L14,13 L24,13 L24,24 L6,24 Z"
                                         HeightRequest="28"
                                         WidthRequest="28"
                                         HorizontalOptions="Center"
                                         VerticalOptions="Center" />
                        </Border>
                        <Label Text="{x:Static loc:AppText.ThisFolderIsEmpty}"
                               Style="{StaticResource SectionTitleLabel}"
                               HorizontalTextAlignment="Center" />
                        <Label Text="{x:Static loc:AppText.EmptyFolderHelp}"
                               Style="{StaticResource MetaLabel}"
                               HorizontalTextAlignment="Center"
                               LineBreakMode="WordWrap" />
                        <HorizontalStackLayout Spacing="10"
                                               HorizontalOptions="Center">
                            <Button Text="{x:Static loc:AppText.Upload}"
                                    Clicked="OnUploadClicked" />
                            <Button Text="{x:Static loc:AppText.NewFolder}"
                                    Style="{StaticResource SecondaryButton}"
                                    Clicked="OnNewFolderClicked" />
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </Border>
            </CollectionView.EmptyView>

            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical"
                                   ItemSpacing="8" />
            </CollectionView.ItemsLayout>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:CloudDriveItem">
                    <Border Padding="10,8"
                            BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}"
                            Stroke="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}"
                            StrokeThickness="1.5">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12" />
                        </Border.StrokeShape>
                        <Grid ColumnDefinitions="Auto,*,Auto"
                              ColumnSpacing="12">
                            <Border HeightRequest="40"
                                    WidthRequest="40"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource PrimarySoftLight}, Dark={StaticResource PrimarySoftDark}}"
                                    Stroke="{AppThemeBinding Light={StaticResource DoodleInk}, Dark={StaticResource BorderDark}}"
                                    StrokeThickness="1.5"
                                    VerticalOptions="Center">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="12" />
                                </Border.StrokeShape>
                                <Label Text="{Binding Badge}"
                                       FontFamily="JetBrainsMono"
                                       FontSize="10"
                                       TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextPrimaryDark}}"
                                       HorizontalTextAlignment="Center"
                                       VerticalTextAlignment="Center"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center" />
                            </Border>

                            <VerticalStackLayout Grid.Column="1"
                                                 Spacing="2"
                                                 VerticalOptions="Center">
                                <Grid ColumnDefinitions="*,Auto"
                                      ColumnSpacing="6">
                                    <Label Text="{Binding Name}"
                                           FontFamily="OpenSansSemibold"
                                           FontSize="16"
                                           TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}"
                                           LineBreakMode="TailTruncation" />
                                    <Label Grid.Column="1"
                                           Text="收藏"
                                           IsVisible="{Binding IsFavorite}"
                                           FontSize="12"
                                           TextColor="{StaticResource Warning}"
                                           VerticalTextAlignment="Center" />
                                </Grid>
                                <Label Text="{Binding DisplayKind}"
                                       Style="{StaticResource MetaLabel}"
                                       FontSize="13"
                                       LineBreakMode="TailTruncation" />
                                <Label Text="{Binding ModifiedAt}"
                                       Style="{StaticResource MetaLabel}"
                                       FontSize="12"
                                       LineBreakMode="TailTruncation" />
                            </VerticalStackLayout>

                            <VerticalStackLayout Grid.Column="2"
                                                 Spacing="4"
                                                 WidthRequest="74"
                                                 VerticalOptions="Center">
                                <Label Text="{Binding Size}"
                                       Style="{StaticResource MonoMetaLabel}"
                                       HorizontalTextAlignment="End"
                                       LineBreakMode="TailTruncation" />
                                <Button Text="详情"
                                        CommandParameter="{Binding .}"
                                        Style="{StaticResource SecondaryButton}"
                                        FontFamily="OpenSansSemibold"
                                        Padding="8,3"
                                        FontSize="12"
                                        MinimumHeightRequest="28"
                                        Clicked="OnDetailsItemClicked" />
                                <Button Text="删除"
                                        CommandParameter="{Binding .}"
                                        Style="{StaticResource DangerButton}"
                                        FontFamily="OpenSansSemibold"
                                        BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}"
                                        Padding="8,3"
                                        FontSize="12"
                                        MinimumHeightRequest="28"
                                        Clicked="OnDeleteItemClicked" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
