<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:loc="clr-namespace:PrivateCloudDrive.App.Localization"
             xmlns:models="clr-namespace:PrivateCloudDrive.App.Models"
             x:Class="PrivateCloudDrive.App.Views.FilesPage"
             Title="{x:Static loc:AppText.Files}"
             Shell.NavBarIsVisible="False">
    <Grid Padding="16,14,16,18" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,*" RowSpacing="14">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
            <VerticalStackLayout Spacing="4">
                <Label Text="{x:Static loc:AppText.Files}"
                       Style="{StaticResource PageTitleLabel}" />
                <Label Text="{Binding ApiBaseUrl}"
                       Style="{StaticResource MetaLabel}" />
            </VerticalStackLayout>
            <Button x:Name="RefreshButton"
                    Grid.Column="1"
                    Text="{x:Static loc:AppText.Refresh}"
                    Style="{StaticResource SecondaryButton}"
                    VerticalOptions="Center"
                    Clicked="OnRefreshClicked" />
        </Grid>

        <Grid Grid.Row="1"
              ColumnDefinitions="Auto,*"
              ColumnSpacing="10"
              IsVisible="{Binding ShowCurrentPath}">
            <Button x:Name="BackButton"
                    Text="{x:Static loc:AppText.Back}"
                    IsVisible="{Binding CanGoBack}"
                    Style="{StaticResource SecondaryButton}"
                    Clicked="OnBackClicked" />
            <Label Grid.Column="1"
                   Text="{Binding CurrentPath}"
                   FontAttributes="Bold"
                   FontSize="15"
                   LineBreakMode="TailTruncation"
                   VerticalOptions="Center"
                   TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
        </Grid>

        <VerticalStackLayout Grid.Row="2" Spacing="10">
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                <SearchBar x:Name="FilesSearchBar"
                           Placeholder="搜索文件"
                           SearchButtonPressed="OnSearchPressed"
                           TextChanged="OnSearchTextChanged" />
                <Button Grid.Column="1"
                        Text="搜索"
                        Style="{StaticResource SecondaryButton}"
                        Clicked="OnSearchClicked" />
                <Button Grid.Column="2"
                        Text="清除"
                        Style="{StaticResource SecondaryButton}"
                        Clicked="OnClearFiltersClicked" />
            </Grid>
            <Grid ColumnDefinitions="*,*,*,Auto" ColumnSpacing="10">
                <Picker x:Name="SortPicker"
                        Title="排序"
                        SelectedIndexChanged="OnFilterChanged" />
                <Picker x:Name="TypeFilterPicker"
                        Grid.Column="1"
                        Title="类型"
                        SelectedIndexChanged="OnFilterChanged" />
                <Picker x:Name="MediaFilterPicker"
                        Grid.Column="2"
                        Title="媒体"
                        SelectedIndexChanged="OnFilterChanged" />
                <HorizontalStackLayout Grid.Column="3" Spacing="6" VerticalOptions="Center">
                    <Label Text="全部"
                           Style="{StaticResource MetaLabel}"
                           VerticalOptions="Center" />
                    <Switch x:Name="SearchAllSwitch"
                            Toggled="OnFilterChanged" />
                </HorizontalStackLayout>
            </Grid>
        </VerticalStackLayout>

        <Grid Grid.Row="3"
              ColumnDefinitions="*,*,Auto"
              ColumnSpacing="10">
            <Button Text="{x:Static loc:AppText.Upload}"
                    TextColor="White"
                    Clicked="OnUploadClicked" />
            <Button Grid.Column="1"
                    Text="{x:Static loc:AppText.NewFolderLower}"
                    Style="{StaticResource SecondaryButton}"
                    Clicked="OnNewFolderClicked" />
            <Button x:Name="SelectionModeButton"
                    Grid.Column="2"
                    Text="选择"
                    Style="{StaticResource SecondaryButton}"
                    Clicked="OnToggleSelectionModeClicked" />
        </Grid>

        <Border x:Name="BatchToolbar"
                Grid.Row="4"
                Padding="12"
                IsVisible="False"
                BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}"
                StrokeThickness="1">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="8" />
            </Border.StrokeShape>
            <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto" ColumnSpacing="8">
                <Label x:Name="SelectedCountLabel"
                       Text="已选择 0 项"
                       FontAttributes="Bold"
                       VerticalOptions="Center"
                       TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
                <Button x:Name="BatchMoveRootButton"
                        Grid.Column="1"
                        Text="移到根目录"
                        Style="{StaticResource SecondaryButton}"
                        Clicked="OnBatchMoveRootClicked" />
                <Button Grid.Column="2"
                        Text="收藏"
                        Style="{StaticResource SecondaryButton}"
                        Clicked="OnBatchFavoriteClicked" />
                <Button Grid.Column="3"
                        Text="取消收藏"
                        Style="{StaticResource SecondaryButton}"
                        Clicked="OnBatchUnfavoriteClicked" />
                <Button Grid.Column="4"
                        Text="{x:Static loc:AppText.Delete}"
                        Style="{StaticResource DangerButton}"
                        Clicked="OnBatchDeleteClicked" />
            </Grid>
        </Border>

        <VerticalStackLayout x:Name="UploadStatusPanel"
                             Grid.Row="5"
                             IsVisible="False"
                             Spacing="8">
            <Label x:Name="UploadStatusLabel"
                   FontSize="13"
                   TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
            <ProgressBar x:Name="UploadProgressBar"
                         Progress="0"
                         ProgressColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
        </VerticalStackLayout>

        <Border x:Name="FilesStatePanel"
                Grid.Row="6"
                Padding="14"
                IsVisible="False"
                BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}"
                StrokeThickness="1">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="8" />
            </Border.StrokeShape>
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                <ActivityIndicator x:Name="FilesLoadingIndicator"
                                   WidthRequest="20"
                                   HeightRequest="20"
                                   Color="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                <Label x:Name="FilesStateLabel"
                       Grid.Column="1"
                       VerticalOptions="Center"
                       FontSize="13"
                       LineBreakMode="WordWrap"
                       TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
                <Button x:Name="FilesRetryButton"
                        Grid.Column="2"
                        Text="{x:Static loc:AppText.Retry}"
                        IsVisible="False"
                        Style="{StaticResource SecondaryButton}"
                        Clicked="OnRetryLoadClicked" />
            </Grid>
        </Border>

        <CollectionView x:Name="FilesCollectionView"
                        Grid.Row="7"
                        ItemsSource="{Binding Items}"
                        SelectionMode="Single"
                        SelectionChanged="OnFileSelected">
            <CollectionView.EmptyView>
                <Border Padding="18"
                        BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}"
                        StrokeThickness="1">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="8" />
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="10"
                                         HorizontalOptions="Center"
                                         VerticalOptions="Center"
                                         MinimumHeightRequest="320">
                        <Label Text="{x:Static loc:AppText.ThisFolderIsEmpty}"
                               Style="{StaticResource SectionTitleLabel}"
                               HorizontalTextAlignment="Center" />
                        <Label Text="{x:Static loc:AppText.EmptyFolderHelp}"
                               Style="{StaticResource MetaLabel}"
                               HorizontalTextAlignment="Center"
                               MaximumWidthRequest="320"
                               LineBreakMode="WordWrap" />
                        <HorizontalStackLayout Spacing="10" HorizontalOptions="Center">
                            <Button Text="{x:Static loc:AppText.Upload}"
                                    Clicked="OnUploadClicked" />
                            <Button Text="{x:Static loc:AppText.NewFolderLower}"
                                    Style="{StaticResource SecondaryButton}"
                                    Clicked="OnNewFolderClicked" />
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </Border>
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:CloudDriveItem">
                    <Grid Padding="0,0,0,10">
                        <Border Padding="14"
                                BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}"
                                StrokeThickness="1">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="8" />
                            </Border.StrokeShape>
                            <Grid ColumnDefinitions="52,*,Auto,Auto,Auto" ColumnSpacing="10">
                                <Border HeightRequest="44"
                                        WidthRequest="44"
                                        BackgroundColor="{AppThemeBinding Light={StaticResource PrimarySoftLight}, Dark={StaticResource PrimarySoftDark}}"
                                        StrokeThickness="0"
                                        VerticalOptions="Center">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="8" />
                                    </Border.StrokeShape>
                                    <Label Text="{Binding Badge}"
                                           FontAttributes="Bold"
                                           FontSize="11"
                                           TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center" />
                                </Border>
                                <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                                    <Label Text="{Binding Name}"
                                           FontAttributes="Bold"
                                           FontSize="16"
                                           TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
                                    <Label Text="{Binding DisplayKind}"
                                           FontSize="13"
                                           TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="2"
                                                     Spacing="3"
                                                     HorizontalOptions="End"
                                                     VerticalOptions="Center">
                                    <Label Text="{Binding Size}"
                                           FontSize="13"
                                           HorizontalTextAlignment="End"
                                           TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
                                    <Label Text="{Binding ModifiedAt}"
                                           FontSize="12"
                                           HorizontalTextAlignment="End"
                                           TextColor="{AppThemeBinding Light={StaticResource TextTertiaryLight}, Dark={StaticResource TextTertiaryDark}}" />
                                </VerticalStackLayout>
                                <Button Grid.Column="3"
                                        Text="{x:Static loc:AppText.More}"
                                        FontSize="12"
                                        Padding="10,0"
                                        MinimumWidthRequest="56"
                                        HeightRequest="44"
                                        Style="{StaticResource SecondaryButton}"
                                        CommandParameter="{Binding .}"
                                        Clicked="OnDetailsItemClicked" />
                                <Button Grid.Column="4"
                                        Text="{x:Static loc:AppText.Delete}"
                                        FontSize="12"
                                        Padding="10,0"
                                        MinimumWidthRequest="64"
                                        HeightRequest="44"
                                        Style="{StaticResource DangerButton}"
                                        CommandParameter="{Binding .}"
                                        Clicked="OnDeleteItemClicked" />
                            </Grid>
                        </Border>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
