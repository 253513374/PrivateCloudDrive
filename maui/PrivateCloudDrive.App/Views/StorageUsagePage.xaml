<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PrivateCloudDrive.App.Views.StorageUsagePage"
             Title="存储用量"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource PageBackgroundDark}">
    <ScrollView>
        <VerticalStackLayout Padding="18,22,18,28"
                             Spacing="16">
            <Grid ColumnDefinitions="Auto,*"
                  ColumnSpacing="12">
                <Button Text="‹"
                        Style="{StaticResource GhostButton}"
                        WidthRequest="46"
                        Clicked="OnBackClicked" />
                <VerticalStackLayout Grid.Column="1"
                                     Spacing="2"
                                     VerticalOptions="Center">
                    <Label Text="存储用量"
                           Style="{StaticResource PageTitleLabel}" />
                    <Label Text="来自当前私有备份服务器的真实容量和健康状态"
                           Style="{StaticResource MetaLabel}" />
                </VerticalStackLayout>
            </Grid>

            <Border Padding="22"
                    BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}"
                    Stroke="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="24" />
                </Border.StrokeShape>
                <Grid ColumnDefinitions="Auto,*"
                      ColumnSpacing="18">
                    <Border HeightRequest="118"
                            WidthRequest="118"
                            BackgroundColor="{AppThemeBinding Light={StaticResource PrimarySoftLight}, Dark={StaticResource PrimarySoftDark}}"
                            Stroke="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                            StrokeThickness="8">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="59" />
                        </Border.StrokeShape>
                        <VerticalStackLayout HorizontalOptions="Center"
                                             VerticalOptions="Center"
                                             Spacing="0">
                            <Label x:Name="UsagePercentLabel"
                                   Text="--"
                                   FontFamily="OpenSansSemibold"
                                   FontSize="24"
                                   HorizontalTextAlignment="Center" />
                            <Label Text="状态"
                                   Style="{StaticResource CaptionLabel}"
                                   HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                    </Border>
                    <VerticalStackLayout Grid.Column="1"
                                         Spacing="8"
                                         VerticalOptions="Center">
                        <Label x:Name="UsageAmountLabel"
                               Text="正在读取容量"
                               Style="{StaticResource SectionTitleLabel}"
                               FontSize="22"
                               LineBreakMode="WordWrap" />
                        <Label x:Name="UsageDetailLabel"
                               Text="连接当前私有备份服务器，读取真实容量和健康状态。"
                               Style="{StaticResource MetaLabel}"
                               LineBreakMode="WordWrap" />
                        <ProgressBar x:Name="UsageProgressBar"
                                     Progress="0"
                                     HeightRequest="8" />
                    </VerticalStackLayout>
                </Grid>
            </Border>

            <Label Text="服务器可信状态"
                   Style="{StaticResource SectionTitleLabel}" />

            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="14">
                    <Grid ColumnDefinitions="Auto,*"
                          ColumnSpacing="12">
                        <Label Text="位"
                               Style="{StaticResource BodyStrongLabel}" />
                        <Label x:Name="StorageLocationLabel"
                               Grid.Column="1"
                               Text="存储位置：读取中"
                               Style="{StaticResource MetaLabel}"
                               LineBreakMode="WordWrap" />
                    </Grid>
                    <Grid ColumnDefinitions="Auto,*"
                          ColumnSpacing="12">
                        <Label Text="存"
                               Style="{StaticResource BodyStrongLabel}" />
                        <Label x:Name="StorageProviderLabel"
                               Grid.Column="1"
                               Text="后端存储：读取中"
                               Style="{StaticResource MetaLabel}"
                               LineBreakMode="WordWrap" />
                    </Grid>
                    <Grid ColumnDefinitions="Auto,*"
                          ColumnSpacing="12">
                        <Label Text="盘"
                               Style="{StaticResource BodyStrongLabel}" />
                        <Label x:Name="DiskSpaceLabel"
                               Grid.Column="1"
                               Text="磁盘空间：读取中"
                               Style="{StaticResource MetaLabel}"
                               LineBreakMode="WordWrap" />
                    </Grid>
                    <Grid ColumnDefinitions="Auto,*"
                          ColumnSpacing="12">
                        <Label Text="额"
                               Style="{StaticResource BodyStrongLabel}" />
                        <Label x:Name="QuotaStateLabel"
                               Grid.Column="1"
                               Text="容量策略：读取中"
                               Style="{StaticResource MetaLabel}"
                               LineBreakMode="WordWrap" />
                    </Grid>
                    <Grid ColumnDefinitions="Auto,*"
                          ColumnSpacing="12">
                        <Label Text="健"
                               Style="{StaticResource BodyStrongLabel}" />
                        <Label x:Name="StorageHealthLabel"
                               Grid.Column="1"
                               Text="健康状态：读取中"
                               Style="{StaticResource MetaLabel}"
                               LineBreakMode="WordWrap" />
                    </Grid>
                    <Grid ColumnDefinitions="Auto,*"
                          ColumnSpacing="12">
                        <Label Text="恢"
                               Style="{StaticResource BodyStrongLabel}" />
                        <Label x:Name="BackupScopeLabel"
                               Grid.Column="1"
                               Text="恢复边界：读取中"
                               Style="{StaticResource MetaLabel}"
                               LineBreakMode="WordWrap" />
                    </Grid>
                    <Grid ColumnDefinitions="Auto,*"
                          ColumnSpacing="12">
                        <Label Text="隐"
                               Style="{StaticResource BodyStrongLabel}" />
                        <Label x:Name="PrivacyBoundaryLabel"
                               Grid.Column="1"
                               Text="隐私边界：读取中"
                               Style="{StaticResource MetaLabel}"
                               LineBreakMode="WordWrap" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <Border Padding="18"
                    BackgroundColor="{AppThemeBinding Light={StaticResource PrimarySoftLight}, Dark={StaticResource PrimarySoftDark}}"
                    Stroke="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                    StrokeThickness="1">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="22" />
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="8">
                    <Label Text="备份建议"
                           Style="{StaticResource SectionTitleLabel}" />
                    <Label x:Name="StorageSuggestionLabel"
                           Text="正在检查私有备份空间。"
                           Style="{StaticResource MetaLabel}"
                           LineBreakMode="WordWrap" />
                    <Button Text="了解智能整理"
                            HorizontalOptions="Fill"
                            Clicked="OnAiCleanupClicked" />
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
