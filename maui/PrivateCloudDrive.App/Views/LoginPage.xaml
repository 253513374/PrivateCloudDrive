<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:loc="clr-namespace:PrivateCloudDrive.App.Localization"
             x:Class="PrivateCloudDrive.App.Views.LoginPage"
             Title="{x:Static loc:AppText.SignIn}"
             Shell.NavBarIsVisible="False">
    <ScrollView>
        <Grid Padding="24" RowDefinitions="*,Auto,*" MinimumHeightRequest="640">
            <VerticalStackLayout Grid.Row="1"
                                 Spacing="20"
                                 MaximumWidthRequest="420"
                                 HorizontalOptions="Fill">
                <VerticalStackLayout Spacing="10">
                    <Border HeightRequest="64"
                            WidthRequest="64"
                            BackgroundColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                            StrokeThickness="0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="16" />
                        </Border.StrokeShape>
                        <Label Text="PCD"
                               TextColor="White"
                               FontFamily="OpenSansSemibold"
                               FontSize="18"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
                    </Border>
                    <Label Text="PrivateCloudDrive"
                           FontFamily="OpenSansSemibold"
                           FontSize="26"
                           TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
                    <Label Text="私有文件与媒体"
                           Style="{StaticResource MetaLabel}" />
                </VerticalStackLayout>

                <Border Padding="18"
                        BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}"
                        StrokeThickness="1">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="8" />
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="14">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="账号密码登录"
                                   Style="{StaticResource SectionTitleLabel}" />
                            <Label Text="{Binding ApiBaseUrl}"
                                   Style="{StaticResource MetaLabel}"
                                   LineBreakMode="TailTruncation" />
                        </VerticalStackLayout>
                        <Border Padding="12,0"
                                BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceAltLight}, Dark={StaticResource SurfaceAltDark}}"
                                StrokeThickness="0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="8" />
                            </Border.StrokeShape>
                            <Entry x:Name="UserNameEntry"
                                   Placeholder="{x:Static loc:AppText.UserNameOrEmail}"
                                   ReturnType="Next" />
                        </Border>
                        <Border Padding="12,0"
                                BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceAltLight}, Dark={StaticResource SurfaceAltDark}}"
                                StrokeThickness="0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="8" />
                            </Border.StrokeShape>
                            <Entry x:Name="PasswordEntry"
                                   Placeholder="{x:Static loc:AppText.Password}"
                                   IsPassword="True"
                                   ReturnType="Done"
                                   Completed="OnPasswordCompleted" />
                        </Border>
                        <Button x:Name="SignInButton"
                                Text="{x:Static loc:AppText.SignInAction}"
                                TextColor="White"
                                Margin="0,4,0,0"
                                Clicked="OnSignInClicked" />
                        <Button x:Name="WechatSignInButton"
                                Text="{x:Static loc:AppText.SignInWithWechat}"
                                Style="{StaticResource SecondaryButton}"
                                IsEnabled="False"
                                Clicked="OnWechatSignInClicked" />
                        <Label x:Name="WechatStatusLabel"
                               Style="{StaticResource MetaLabel}"
                               LineBreakMode="WordWrap" />
                        <HorizontalStackLayout x:Name="SignInLoadingPanel"
                                               IsVisible="False"
                                               Spacing="8"
                                               HorizontalOptions="Center">
                            <ActivityIndicator x:Name="SignInLoadingIndicator"
                                               WidthRequest="18"
                                               HeightRequest="18"
                                               Color="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                            <Label Text="{x:Static loc:AppText.SigningIn}"
                                   Style="{StaticResource MetaLabel}"
                                   VerticalOptions="Center" />
                        </HorizontalStackLayout>
                        <Label x:Name="ValidationLabel"
                               IsVisible="False"
                               TextColor="{StaticResource Danger}"
                               FontSize="13"
                               LineBreakMode="WordWrap" />
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </Grid>
    </ScrollView>
</ContentPage>
