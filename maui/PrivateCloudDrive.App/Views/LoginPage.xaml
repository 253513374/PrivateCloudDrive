<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:loc="clr-namespace:PrivateCloudDrive.App.Localization"
             x:Class="PrivateCloudDrive.App.Views.LoginPage"
             Title="{x:Static loc:AppText.SignIn}"
             Shell.NavBarIsVisible="False">
    <ScrollView>
        <Grid Padding="24" RowDefinitions="*,Auto,*" MinimumHeightRequest="640">
            <VerticalStackLayout Grid.Row="1" Spacing="18">
                <Label Text="PrivateCloudDrive"
                       Style="{StaticResource PageTitleLabel}" />
                <Label Text="{Binding ApiBaseUrl}"
                       Style="{StaticResource MetaLabel}" />
                <Label Text="{Binding ClientId}"
                       Style="{StaticResource MetaLabel}" />

                <Border Padding="18"
                        BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}"
                        StrokeThickness="1">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="8" />
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="14">
                        <Border Padding="12,0"
                                BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceAltLight}, Dark={StaticResource SurfaceAltDark}}"
                                StrokeThickness="0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="8" />
                            </Border.StrokeShape>
                            <Entry x:Name="UserNameEntry"
                                   Placeholder="{x:Static loc:AppText.UserNameOrEmail}"
                                   ReturnType="Next" />
                        </Border>
                        <Border Padding="12,0"
                                BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceAltLight}, Dark={StaticResource SurfaceAltDark}}"
                                StrokeThickness="0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="8" />
                            </Border.StrokeShape>
                            <Entry x:Name="PasswordEntry"
                                   Placeholder="{x:Static loc:AppText.Password}"
                                   IsPassword="True"
                                   ReturnType="Done"
                                   Completed="OnPasswordCompleted" />
                        </Border>
                        <Button x:Name="SignInButton"
                                Text="{x:Static loc:AppText.SignInAction}"
                                TextColor="White"
                                Clicked="OnSignInClicked" />
                        <Button x:Name="WechatSignInButton"
                                Text="{x:Static loc:AppText.SignInWithWechat}"
                                Style="{StaticResource SecondaryButton}"
                                IsVisible="False"
                                Clicked="OnWechatSignInClicked" />
                        <HorizontalStackLayout x:Name="SignInLoadingPanel"
                                               IsVisible="False"
                                               Spacing="8"
                                               HorizontalOptions="Center">
                            <ActivityIndicator x:Name="SignInLoadingIndicator"
                                               WidthRequest="18"
                                               HeightRequest="18"
                                               Color="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                            <Label Text="{x:Static loc:AppText.SigningIn}"
                                   Style="{StaticResource MetaLabel}"
                                   VerticalOptions="Center" />
                        </HorizontalStackLayout>
                        <Label x:Name="ValidationLabel"
                               IsVisible="False"
                               TextColor="{StaticResource Danger}"
                               FontSize="13" />
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </Grid>
    </ScrollView>
</ContentPage>
