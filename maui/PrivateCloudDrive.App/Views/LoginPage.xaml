<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:loc="clr-namespace:PrivateCloudDrive.App.Localization"
             xmlns:services="clr-namespace:PrivateCloudDrive.App.Services"
             xmlns:shapes="clr-namespace:Microsoft.Maui.Controls.Shapes;assembly=Microsoft.Maui.Controls"
             x:Class="PrivateCloudDrive.App.Views.LoginPage"
             Title="{x:Static loc:AppText.SignIn}"
             Shell.NavBarIsVisible="False">
    <ScrollView>
        <Grid Padding="24,40,24,24"
              RowDefinitions="Auto"
              MinimumHeightRequest="720">
            <Border Grid.Row="1"
                    Style="{StaticResource Card}"
                    MaximumWidthRequest="520"
                    HorizontalOptions="Center">
                <VerticalStackLayout Spacing="24">
                    <VerticalStackLayout Spacing="14"
                                         HorizontalOptions="Center">
                        <Border HeightRequest="72"
                                WidthRequest="72"
                                BackgroundColor="{AppThemeBinding Light={StaticResource PrimarySoftLight}, Dark={StaticResource PrimarySoftDark}}"
                                StrokeThickness="0"
                                Padding="13">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="24" />
                            </Border.StrokeShape>
                            <Image Source="privateclouddrive_mark.png"
                                   Aspect="AspectFit"
                                   SemanticProperties.Description="PrivateCloudDrive" />
                        </Border>

                        <VerticalStackLayout Spacing="6"
                                             HorizontalOptions="Center">
                            <Label Text="PrivateCloudDrive"
                                   FontFamily="OpenSansSemibold"
                                   FontSize="24"
                                   TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}"
                                   HorizontalTextAlignment="Center"
                                   LineBreakMode="NoWrap" />
                            <Label Text="安全访问你的私有文件与媒体"
                                   Style="{StaticResource MetaLabel}"
                                   FontSize="14"
                                   HorizontalTextAlignment="Center"
                                   LineBreakMode="WordWrap" />
                        </VerticalStackLayout>
                    </VerticalStackLayout>

                    <Border Style="{StaticResource SoftCard}"
                            Padding="12,10">
                        <Grid ColumnDefinitions="Auto,*"
                              ColumnSpacing="12">
                            <Border HeightRequest="36"
                                    WidthRequest="36"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource SuccessSoftLight}, Dark={StaticResource SuccessSoftDark}}"
                                    StrokeThickness="0">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="12" />
                                </Border.StrokeShape>
                                <shapes:Path Aspect="Uniform"
                                             Stroke="{StaticResource Success}"
                                             StrokeThickness="1.8"
                                             StrokeLineCap="Round"
                                             StrokeLineJoin="Round"
                                             Data="M4,14 L10,20 L22,8"
                                             HeightRequest="20"
                                             WidthRequest="20"
                                             HorizontalOptions="Center"
                                             VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1"
                                                 Spacing="2"
                                                 VerticalOptions="Center">
                                <Label Text="当前连接"
                                       Style="{StaticResource CaptionLabel}" />
                                <Label Text="{x:Static services:AppSettings.ApiBaseUrl}"
                                       Style="{StaticResource MonoMetaLabel}"
                                       LineBreakMode="TailTruncation" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>

                    <VerticalStackLayout Spacing="18">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="账号登录"
                                   Style="{StaticResource SectionTitleLabel}" />
                            <Label Text="使用你的账号密码进入私有云盘。当前设备仅连接你信任的服务。"
                                   Style="{StaticResource MetaLabel}"
                                   LineBreakMode="WordWrap" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="14">
                            <VerticalStackLayout Spacing="7">
                                <Label Text="用户名或邮箱"
                                       Style="{StaticResource BodyStrongLabel}"
                                       FontSize="14" />
                                <Border Style="{StaticResource InputContainer}"
                                        HeightRequest="52">
                                    <Grid ColumnDefinitions="28,*"
                                          ColumnSpacing="12">
                                        <shapes:Path Aspect="Uniform"
                                                     Stroke="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}"
                                                     StrokeThickness="1.8"
                                                     StrokeLineCap="Round"
                                                     StrokeLineJoin="Round"
                                                     Data="M14,14 C17,14 19.5,11.5 19.5,8.5 C19.5,5.5 17,3 14,3 C11,3 8.5,5.5 8.5,8.5 C8.5,11.5 11,14 14,14 Z M5,26 C5.7,20.5 9,17.5 14,17.5 C19,17.5 22.3,20.5 23,26"
                                                     HeightRequest="23"
                                                     WidthRequest="23"
                                                     HorizontalOptions="Center"
                                                     VerticalOptions="Center" />
                                        <Entry x:Name="UserNameEntry"
                                               Grid.Column="1"
                                               Placeholder="{x:Static loc:AppText.UserNameOrEmail}"
                                               ReturnType="Next" />
                                    </Grid>
                                </Border>
                            </VerticalStackLayout>

                            <VerticalStackLayout Spacing="7">
                                <Label Text="密码"
                                       Style="{StaticResource BodyStrongLabel}"
                                       FontSize="14" />
                                <Border Style="{StaticResource InputContainer}"
                                        HeightRequest="52">
                                    <Grid ColumnDefinitions="28,*,36"
                                          ColumnSpacing="12">
                                        <shapes:Path Aspect="Uniform"
                                                     Stroke="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}"
                                                     StrokeThickness="1.8"
                                                     StrokeLineCap="Round"
                                                     StrokeLineJoin="Round"
                                                     Data="M6,13 L6,26 L22,26 L22,13 Z M9,13 L9,9 C9,5.8 11,4 14,4 C17,4 19,5.8 19,9 L19,13"
                                                     HeightRequest="23"
                                                     WidthRequest="23"
                                                     HorizontalOptions="Center"
                                                     VerticalOptions="Center" />
                                        <Entry x:Name="PasswordEntry"
                                               Grid.Column="1"
                                               Placeholder="{x:Static loc:AppText.Password}"
                                               IsPassword="True"
                                               ReturnType="Done"
                                               Completed="OnPasswordCompleted" />
                                        <Grid x:Name="PasswordVisibilityToggle"
                                              Grid.Column="2"
                                              SemanticProperties.Description="显示或隐藏密码"
                                              HeightRequest="36"
                                              WidthRequest="36"
                                              VerticalOptions="Center">
                                            <Grid.GestureRecognizers>
                                                <TapGestureRecognizer Tapped="OnTogglePasswordVisibilityTapped" />
                                            </Grid.GestureRecognizers>
                                            <shapes:Path x:Name="PasswordHiddenIcon"
                                                         Aspect="Uniform"
                                                         Stroke="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}"
                                                         StrokeThickness="1.7"
                                                         StrokeLineCap="Round"
                                                         StrokeLineJoin="Round"
                                                         Data="M3,14 C6.2,9 10,6.5 14,6.5 C18,6.5 21.8,9 25,14 C23.7,16 22.1,17.7 20.2,18.9 M16.4,20.2 C15.6,20.4 14.8,20.5 14,20.5 C10,20.5 6.2,18 3,14 M5,4 L24,23"
                                                         HeightRequest="24"
                                                         WidthRequest="24"
                                                         HorizontalOptions="Center"
                                                         VerticalOptions="Center" />
                                            <shapes:Path x:Name="PasswordVisibleIcon"
                                                         IsVisible="False"
                                                         Aspect="Uniform"
                                                         Stroke="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}"
                                                         StrokeThickness="1.7"
                                                         StrokeLineCap="Round"
                                                         StrokeLineJoin="Round"
                                                         Data="M3,14 C6.2,9 10,6.5 14,6.5 C18,6.5 21.8,9 25,14 C21.8,19 18,21.5 14,21.5 C10,21.5 6.2,19 3,14 Z M14,10.2 C16.1,10.2 17.8,11.9 17.8,14 C17.8,16.1 16.1,17.8 14,17.8 C11.9,17.8 10.2,16.1 10.2,14 C10.2,11.9 11.9,10.2 14,10.2 Z"
                                                         HeightRequest="24"
                                                         WidthRequest="24"
                                                         HorizontalOptions="Center"
                                                         VerticalOptions="Center" />
                                        </Grid>
                                    </Grid>
                                </Border>
                            </VerticalStackLayout>
                        </VerticalStackLayout>

                        <Button x:Name="SignInButton"
                                Text="{x:Static loc:AppText.SignInAction}"
                                HeightRequest="50"
                                FontSize="16"
                                Clicked="OnSignInClicked" />

                        <Grid ColumnDefinitions="*,Auto"
                              Margin="0,-6,0,0">
                            <Label Text="请联系管理员创建账号"
                                   Style="{StaticResource MetaLabel}"
                                   FontSize="13" />
                            <Label Grid.Column="1"
                                   Text="忘记密码？"
                                   Style="{StaticResource MetaLabel}"
                                   FontSize="13"
                                   TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                        </Grid>

                        <HorizontalStackLayout x:Name="SignInLoadingPanel"
                                               IsVisible="False"
                                               Spacing="12"
                                               HorizontalOptions="Center">
                            <ActivityIndicator x:Name="SignInLoadingIndicator"
                                               WidthRequest="22"
                                               HeightRequest="22"
                                               VerticalOptions="Center" />
                            <Label Text="{x:Static loc:AppText.SigningIn}"
                                   Style="{StaticResource MetaLabel}"
                                   FontSize="15"
                                   VerticalOptions="Center" />
                            <Button x:Name="SignInCancelButton"
                                    Text="{x:Static loc:AppText.Cancel}"
                                    Style="{StaticResource SecondaryButton}"
                                    Padding="12,4"
                                    HeightRequest="32"
                                    IsVisible="False"
                                    Clicked="OnCancelSignInClicked" />
                        </HorizontalStackLayout>

                        <Border x:Name="ValidationPanel"
                                IsVisible="False"
                                BackgroundColor="{AppThemeBinding Light={StaticResource DangerSoftLight}, Dark={StaticResource DangerSoftDark}}"
                                StrokeThickness="0"
                                Padding="12,10">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12" />
                            </Border.StrokeShape>
                            <Label x:Name="ValidationLabel"
                                   IsVisible="False"
                                   TextColor="{StaticResource Danger}"
                                   FontFamily="OpenSansSemibold"
                                   FontSize="13"
                                   LineBreakMode="WordWrap" />
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout x:Name="ExternalSignInPanel"
                                         Spacing="14">
                        <Grid ColumnDefinitions="*,Auto,*"
                              ColumnSpacing="14">
                            <BoxView HeightRequest="1"
                                     Color="{AppThemeBinding Light={StaticResource DividerLight}, Dark={StaticResource DividerDark}}"
                                     VerticalOptions="Center" />
                            <Label Grid.Column="1"
                                   Text="其他登录方式"
                                   Style="{StaticResource CaptionLabel}" />
                            <BoxView Grid.Column="2"
                                     HeightRequest="1"
                                     Color="{AppThemeBinding Light={StaticResource DividerLight}, Dark={StaticResource DividerDark}}"
                                     VerticalOptions="Center" />
                        </Grid>

                        <HorizontalStackLayout Spacing="18"
                                               HorizontalOptions="Center">
                            <VerticalStackLayout x:Name="WechatSignInEntry"
                                                 Spacing="6">
                                <ImageButton x:Name="WechatSignInButton"
                                             Source="icon_wechat.png"
                                             SemanticProperties.Description="{x:Static loc:AppText.SignInWithWechat}"
                                             BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceAltDark}}"
                                             BorderColor="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}"
                                             BorderWidth="1"
                                             CornerRadius="14"
                                             Padding="12"
                                             HeightRequest="54"
                                             WidthRequest="54"
                                             IsEnabled="True"
                                             InputTransparent="True"
                                             Opacity="0.65"
                                             Clicked="OnWechatSignInClicked" />
                                <Label x:Name="WechatStatusLabel"
                                       IsVisible="False"
                                       Style="{StaticResource MetaLabel}"
                                       HorizontalTextAlignment="Center"
                                       LineBreakMode="WordWrap" />
                            </VerticalStackLayout>

                            <VerticalStackLayout x:Name="GoogleSignInEntry"
                                                 Spacing="6">
                                <ImageButton x:Name="GoogleSignInButton"
                                             Source="icon_google.png"
                                             SemanticProperties.Description="{x:Static loc:AppText.SignInWithGoogle}"
                                             BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceAltDark}}"
                                             BorderColor="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}"
                                             BorderWidth="1"
                                             CornerRadius="14"
                                             Padding="12"
                                             HeightRequest="54"
                                             WidthRequest="54"
                                             IsEnabled="True"
                                             InputTransparent="True"
                                             Opacity="0.65"
                                             Clicked="OnGoogleSignInClicked" />
                                <Label x:Name="GoogleStatusLabel"
                                       IsVisible="False"
                                       Style="{StaticResource MetaLabel}"
                                       HorizontalTextAlignment="Center"
                                       LineBreakMode="WordWrap" />
                            </VerticalStackLayout>

                            <VerticalStackLayout x:Name="GitHubSignInEntry"
                                                 Spacing="6">
                                <ImageButton x:Name="GitHubSignInButton"
                                             Source="icon_github.png"
                                             SemanticProperties.Description="{x:Static loc:AppText.SignInWithGitHub}"
                                             BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceAltDark}}"
                                             BorderColor="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}"
                                             BorderWidth="1"
                                             CornerRadius="14"
                                             Padding="12"
                                             HeightRequest="54"
                                             WidthRequest="54"
                                             IsEnabled="True"
                                             InputTransparent="True"
                                             Opacity="0.65"
                                             Clicked="OnGitHubSignInClicked" />
                                <Label x:Name="GitHubStatusLabel"
                                       IsVisible="False"
                                       Style="{StaticResource MetaLabel}"
                                       HorizontalTextAlignment="Center"
                                       LineBreakMode="WordWrap" />
                            </VerticalStackLayout>
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>
        </Grid>
    </ScrollView>
</ContentPage>
