<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:PrivateCloudDrive.App.Models"
             x:Class="PrivateCloudDrive.App.Views.MediaAlbumDetailPage"
             Title="{Binding AlbumName}">
    <Grid Padding="18" RowDefinitions="Auto,Auto,*" RowSpacing="14">
        <Border Padding="14"
                BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}"
                StrokeThickness="1">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="8" />
            </Border.StrokeShape>
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <VerticalStackLayout Spacing="4">
                    <Label Text="{Binding AlbumName}" Style="{StaticResource PageTitleLabel}" />
                    <Label Text="{Binding ItemCountText}" Style="{StaticResource MetaLabel}" />
                </VerticalStackLayout>
                <HorizontalStackLayout Grid.Column="1" Spacing="8" VerticalOptions="Center">
                    <Button Text="添加媒体"
                            TextColor="White"
                            Clicked="OnAddMediaClicked" />
                    <Button Text="刷新"
                            Style="{StaticResource SecondaryButton}"
                            Clicked="OnRefreshClicked" />
                    <Button Text="删除"
                            Style="{StaticResource DangerButton}"
                            Clicked="OnDeleteAlbumClicked" />
                </HorizontalStackLayout>
            </Grid>
        </Border>

        <Border x:Name="StatePanel"
                Grid.Row="1"
                Padding="14"
                IsVisible="False"
                BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}"
                StrokeThickness="1">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="8" />
            </Border.StrokeShape>
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                <ActivityIndicator x:Name="LoadingIndicator"
                                   WidthRequest="20"
                                   HeightRequest="20"
                                   Color="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                <Label x:Name="StateLabel"
                       Grid.Column="1"
                       VerticalOptions="Center"
                       FontSize="13"
                       LineBreakMode="WordWrap" />
            </Grid>
        </Border>

        <CollectionView Grid.Row="2"
                        ItemsSource="{Binding Items}"
                        SelectionMode="Single"
                        SelectionChanged="OnItemSelected">
            <CollectionView.ItemsLayout>
                <GridItemsLayout Orientation="Vertical" Span="2" HorizontalItemSpacing="10" VerticalItemSpacing="12" />
            </CollectionView.ItemsLayout>
            <CollectionView.EmptyView>
                <Border Padding="18"
                        BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}"
                        StrokeThickness="1">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="8" />
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="6" HorizontalOptions="Center" VerticalOptions="Center">
                        <Label Text="相册为空" Style="{StaticResource SectionTitleLabel}" HorizontalTextAlignment="Center" />
                        <Label Text="使用“添加媒体”选择要整理进来的图片或视频。" Style="{StaticResource MetaLabel}" HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </Border>
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:MediaLibraryItem">
                    <Border BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}"
                            StrokeThickness="1">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="8" />
                        </Border.StrokeShape>
                        <Grid RowDefinitions="120,Auto,Auto">
                            <Grid BackgroundColor="{AppThemeBinding Light={StaticResource PrimarySoftLight}, Dark={StaticResource PrimarySoftDark}}">
                                <Image Source="{Binding ThumbnailSource}" Aspect="AspectFill" IsVisible="{Binding HasThumbnail}" />
                                <Label Text="{Binding Badge}"
                                       IsVisible="{Binding ShowBadge}"
                                       FontAttributes="Bold"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"
                                       TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                                <Border HorizontalOptions="End"
                                        VerticalOptions="End"
                                        Margin="7"
                                        Padding="6,2"
                                        IsVisible="{Binding ShowVideoDuration}"
                                        BackgroundColor="#99000000"
                                        StrokeThickness="0">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="8" />
                                    </Border.StrokeShape>
                                    <Label Text="{Binding DurationText}" FontSize="10" TextColor="White" />
                                </Border>
                            </Grid>
                            <VerticalStackLayout Grid.Row="1" Padding="10,8,10,4" Spacing="2">
                                <Label Text="{Binding Name}" FontAttributes="Bold" FontSize="13" LineBreakMode="TailTruncation" />
                                <Label Text="{Binding SecondaryText}" Style="{StaticResource MetaLabel}" LineBreakMode="TailTruncation" />
                            </VerticalStackLayout>
                            <Grid Grid.Row="2" Padding="10,0,10,10" ColumnDefinitions="*,*" ColumnSpacing="8">
                                <Button Text="封面"
                                        Style="{StaticResource SecondaryButton}"
                                        CommandParameter="{Binding Id}"
                                        Clicked="OnSetCoverClicked" />
                                <Button Grid.Column="1"
                                        Text="移除"
                                        Style="{StaticResource SecondaryButton}"
                                        CommandParameter="{Binding Id}"
                                        Clicked="OnRemoveClicked" />
                            </Grid>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
