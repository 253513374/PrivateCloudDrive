<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:PrivateCloudDrive.App.Models"
             x:Class="PrivateCloudDrive.App.Views.MediaAlbumDetailPage"
             Title="{Binding AlbumName}">
    <Grid Padding="18" RowDefinitions="Auto,Auto,*" RowSpacing="14">
        <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8">
            <VerticalStackLayout Spacing="4">
                <Label Text="{Binding AlbumName}" Style="{StaticResource PageTitleLabel}" />
                <Label Text="{Binding ItemCountText}" Style="{StaticResource MetaLabel}" />
            </VerticalStackLayout>
            <Button Grid.Column="1"
                    Text="添加最近"
                    TextColor="White"
                    Clicked="OnAddRecentClicked" />
            <Button Grid.Column="2"
                    Text="刷新"
                    Style="{StaticResource SecondaryButton}"
                    Clicked="OnRefreshClicked" />
            <Button Grid.Column="3"
                    Text="删除"
                    Style="{StaticResource SecondaryButton}"
                    Clicked="OnDeleteAlbumClicked" />
        </Grid>

        <Border x:Name="StatePanel"
                Grid.Row="1"
                Padding="14"
                IsVisible="False"
                BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}"
                StrokeThickness="1">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="8" />
            </Border.StrokeShape>
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                <ActivityIndicator x:Name="LoadingIndicator"
                                   WidthRequest="20"
                                   HeightRequest="20"
                                   Color="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                <Label x:Name="StateLabel"
                       Grid.Column="1"
                       VerticalOptions="Center"
                       FontSize="13"
                       LineBreakMode="WordWrap" />
            </Grid>
        </Border>

        <CollectionView Grid.Row="2"
                        ItemsSource="{Binding Items}"
                        SelectionMode="Single"
                        SelectionChanged="OnItemSelected">
            <CollectionView.EmptyView>
                <Border Padding="18"
                        BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}"
                        StrokeThickness="1">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="8" />
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="6" HorizontalOptions="Center" VerticalOptions="Center">
                        <Label Text="相册为空" Style="{StaticResource SectionTitleLabel}" HorizontalTextAlignment="Center" />
                        <Label Text="使用“添加最近”把媒体加入相册。" Style="{StaticResource MetaLabel}" HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </Border>
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:MediaLibraryItem">
                    <Grid Padding="0,0,0,10">
                        <Border Padding="12"
                                BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}"
                                StrokeThickness="1">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="8" />
                            </Border.StrokeShape>
                            <Grid ColumnDefinitions="80,*,Auto,Auto" ColumnSpacing="10">
                                <Border WidthRequest="80" HeightRequest="56" StrokeThickness="0" BackgroundColor="{AppThemeBinding Light={StaticResource PrimarySoftLight}, Dark={StaticResource PrimarySoftDark}}">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="8" />
                                    </Border.StrokeShape>
                                    <Grid>
                                        <Image Source="{Binding ThumbnailSource}" Aspect="AspectFill" IsVisible="{Binding HasThumbnail}" />
                                        <Label Text="{Binding Badge}" IsVisible="{Binding ShowBadge}" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" />
                                    </Grid>
                                </Border>
                                <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                                    <Label Text="{Binding Name}" FontAttributes="Bold" LineBreakMode="TailTruncation" />
                                    <Label Text="{Binding SecondaryText}" Style="{StaticResource MetaLabel}" />
                                </VerticalStackLayout>
                                <Button Grid.Column="2"
                                        Text="封面"
                                        Style="{StaticResource SecondaryButton}"
                                        CommandParameter="{Binding Id}"
                                        Clicked="OnSetCoverClicked" />
                                <Button Grid.Column="3"
                                        Text="移除"
                                        Style="{StaticResource SecondaryButton}"
                                        CommandParameter="{Binding Id}"
                                        Clicked="OnRemoveClicked" />
                            </Grid>
                        </Border>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
