<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:loc="clr-namespace:PrivateCloudDrive.App.Localization"
             xmlns:shapes="clr-namespace:Microsoft.Maui.Controls.Shapes;assembly=Microsoft.Maui.Controls"
             x:Class="PrivateCloudDrive.App.Views.SharesPage"
             Title="{x:Static loc:AppText.Shares}"
             Shell.NavBarIsVisible="False">
    <Grid Padding="18,18,18,16"
          RowDefinitions="Auto,Auto,*"
          RowSpacing="10">
        <Grid ColumnDefinitions="*,Auto"
              ColumnSpacing="12">
            <VerticalStackLayout Spacing="4">
                <Label Text="{x:Static loc:AppText.Shares}"
                       Style="{StaticResource PageTitleLabel}"
                       FontSize="28" />
                <Label Text="管理已创建的分享链接、访问状态和失效风险"
                       Style="{StaticResource MetaLabel}"
                       FontSize="14"
                       LineBreakMode="WordWrap" />
            </VerticalStackLayout>
            <Button Grid.Column="1"
                    Text="{x:Static loc:AppText.Refresh}"
                    Style="{StaticResource SecondaryButton}"
                    Padding="14,8"
                    HeightRequest="46"
                    WidthRequest="86"
                    VerticalOptions="Center"
                    Clicked="OnRefreshClicked" />
        </Grid>

        <Border x:Name="StatePanel"
                Grid.Row="1"
                Padding="14"
                IsVisible="False"
                BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}"
                Stroke="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="10" />
            </Border.StrokeShape>
            <Grid ColumnDefinitions="Auto,*,Auto"
                  ColumnSpacing="10">
                <ActivityIndicator x:Name="LoadingIndicator"
                                   WidthRequest="20"
                                   HeightRequest="20"
                                   Color="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                                   VerticalOptions="Center" />
                <Label x:Name="StateLabel"
                       Grid.Column="1"
                       VerticalOptions="Center"
                       FontSize="13"
                       LineBreakMode="WordWrap"
                       TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
                <Button x:Name="RetryButton"
                        Grid.Column="2"
                        Text="{x:Static loc:AppText.Retry}"
                        IsVisible="False"
                        Style="{StaticResource SecondaryButton}"
                        Padding="12,6"
                        MinimumHeightRequest="36"
                        Clicked="OnRefreshClicked" />
            </Grid>
        </Border>

        <CollectionView Grid.Row="2"
                        ItemsSource="{Binding Shares}"
                        SelectionMode="None">
            <CollectionView.EmptyView>
                <Border Padding="20"
                        BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}"
                        VerticalOptions="Start"
                        HeightRequest="240"
                        Stroke="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="10" />
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="10"
                                         HorizontalOptions="Center"
                                         VerticalOptions="Center">
                        <Border HeightRequest="54"
                                WidthRequest="54"
                                BackgroundColor="{AppThemeBinding Light={StaticResource PrimarySoftLight}, Dark={StaticResource PrimarySoftDark}}"
                                StrokeThickness="0"
                                HorizontalOptions="Center">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12" />
                            </Border.StrokeShape>
                            <shapes:Path Aspect="Uniform"
                                         Stroke="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                                         StrokeThickness="1.9"
                                         StrokeLineCap="Round"
                                         StrokeLineJoin="Round"
                                         Data="M8,12 C10.2,12 12,10.2 12,8 C12,5.8 10.2,4 8,4 C5.8,4 4,5.8 4,8 C4,10.2 5.8,12 8,12 Z M3,21 C3.7,17.2 5.4,15 8,15 C10.6,15 12.3,17.2 13,21 M16,10 C17.7,10 19,8.7 19,7 C19,5.3 17.7,4 16,4 M15,15 C17.8,15.2 20,17.3 21,21"
                                         HeightRequest="30"
                                         WidthRequest="30"
                                         HorizontalOptions="Center"
                                         VerticalOptions="Center" />
                        </Border>
                        <Label Text="暂无共享链接"
                               Style="{StaticResource SectionTitleLabel}"
                               HorizontalTextAlignment="Center" />
                        <Label Text="从文件详情页创建分享后，链接、访问次数、有效期和禁用入口会显示在这里。"
                               Style="{StaticResource MetaLabel}"
                               HorizontalTextAlignment="Center"
                               LineBreakMode="WordWrap" />
                    </VerticalStackLayout>
                </Border>
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Grid Padding="0,0,0,10">
                        <Border Padding="14"
                                BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}"
                                Stroke="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="10" />
                            </Border.StrokeShape>
                            <VerticalStackLayout Spacing="10">
                                <Grid ColumnDefinitions="*,Auto"
                                      ColumnSpacing="10">
                                    <VerticalStackLayout Spacing="4">
                                        <Label Text="{Binding FileName}"
                                               FontFamily="OpenSansSemibold"
                                               FontSize="16"
                                               TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}"
                                               LineBreakMode="TailTruncation" />
                                        <Label Text="{Binding StatusText}"
                                               Style="{StaticResource MetaLabel}" />
                                    </VerticalStackLayout>
                                    <Border Grid.Column="1"
                                            Padding="9,5"
                                            BackgroundColor="{AppThemeBinding Light={StaticResource PrimarySoftLight}, Dark={StaticResource PrimarySoftDark}}"
                                            StrokeThickness="0"
                                            VerticalOptions="Start">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="14" />
                                        </Border.StrokeShape>
                                        <Label Text="{Binding VisitText}"
                                               FontFamily="OpenSansSemibold"
                                               FontSize="12"
                                               TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                                    </Border>
                                </Grid>
                                <Border Padding="10,8"
                                        BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceAltLight}, Dark={StaticResource SurfaceAltDark}}"
                                        StrokeThickness="0">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="8" />
                                    </Border.StrokeShape>
                                    <Label Text="{Binding Link}"
                                           Style="{StaticResource MetaLabel}"
                                           LineBreakMode="TailTruncation" />
                                </Border>
                                <Grid ColumnDefinitions="*,*"
                                      ColumnSpacing="10">
                                    <Label Text="{Binding CreatedText}"
                                           Style="{StaticResource MetaLabel}" />
                                    <Label Grid.Column="1"
                                           Text="{Binding ExpirationText}"
                                           Style="{StaticResource MetaLabel}"
                                           HorizontalTextAlignment="End" />
                                </Grid>
                                <Grid ColumnDefinitions="*,*"
                                      ColumnSpacing="10">
                                    <Button Text="复制链接"
                                            Style="{StaticResource SecondaryButton}"
                                            CommandParameter="{Binding .}"
                                            Clicked="OnCopyClicked" />
                                    <Button Grid.Column="1"
                                            Text="禁用"
                                            Style="{StaticResource DangerButton}"
                                            IsEnabled="{Binding CanDisable}"
                                            CommandParameter="{Binding .}"
                                            Clicked="OnDisableClicked" />
                                </Grid>
                            </VerticalStackLayout>
                        </Border>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
