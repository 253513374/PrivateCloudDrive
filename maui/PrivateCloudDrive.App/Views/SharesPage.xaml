<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PrivateCloudDrive.App.Views.SharesPage"
             Title="我的分享">
    <Grid Padding="18" RowDefinitions="Auto,Auto,*" RowSpacing="16">
        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
            <Button Text="返回"
                    Style="{StaticResource SecondaryButton}"
                    Clicked="OnBackClicked" />
            <VerticalStackLayout Grid.Column="1" Spacing="4">
                <Label Text="我的分享"
                       Style="{StaticResource PageTitleLabel}" />
                <Label Text="查看、复制或禁用已创建的分享链接。"
                       Style="{StaticResource MetaLabel}" />
            </VerticalStackLayout>
            <Button Grid.Column="2"
                    Text="刷新"
                    Style="{StaticResource SecondaryButton}"
                    Clicked="OnRefreshClicked" />
        </Grid>

        <Border x:Name="StatePanel"
                Grid.Row="1"
                Padding="14"
                IsVisible="False"
                BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}"
                StrokeThickness="2">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="8" />
            </Border.StrokeShape>
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                <ActivityIndicator x:Name="LoadingIndicator"
                                   WidthRequest="20"
                                   HeightRequest="20"
                                   Color="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                <Label x:Name="StateLabel"
                       Grid.Column="1"
                       VerticalOptions="Center"
                       FontSize="13"
                       LineBreakMode="WordWrap"
                       TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
                <Button x:Name="RetryButton"
                        Grid.Column="2"
                        Text="重试"
                        IsVisible="False"
                        Style="{StaticResource SecondaryButton}"
                        Clicked="OnRefreshClicked" />
            </Grid>
        </Border>

        <CollectionView Grid.Row="2"
                        ItemsSource="{Binding Shares}"
                        SelectionMode="None">
            <CollectionView.EmptyView>
                <Border Padding="18"
                        BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}"
                        StrokeThickness="2">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="8" />
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="6"
                                         HorizontalOptions="Center"
                                         VerticalOptions="Center"
                                         MinimumHeightRequest="280">
                        <Label Text="暂无分享"
                               Style="{StaticResource SectionTitleLabel}"
                               HorizontalTextAlignment="Center" />
                        <Label Text="在文件详情页创建分享后会显示在这里。"
                               Style="{StaticResource MetaLabel}"
                               HorizontalTextAlignment="Center"
                               LineBreakMode="WordWrap" />
                    </VerticalStackLayout>
                </Border>
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Grid Padding="0,0,0,10">
                        <Border Padding="14"
                                BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}"
                                StrokeThickness="2">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="8" />
                            </Border.StrokeShape>
                            <VerticalStackLayout Spacing="10">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                    <VerticalStackLayout Spacing="4">
                                        <Label Text="{Binding FileName}"
                                               FontAttributes="Bold"
                                               FontSize="16"
                                               TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
                                        <Label Text="{Binding StatusText}"
                                               Style="{StaticResource MetaLabel}" />
                                    </VerticalStackLayout>
                                    <Label Grid.Column="1"
                                           Text="{Binding VisitText}"
                                           Style="{StaticResource MetaLabel}"
                                           VerticalOptions="Center" />
                                </Grid>
                                <Label Text="{Binding Link}"
                                       Style="{StaticResource MetaLabel}"
                                       LineBreakMode="TailTruncation" />
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                    <Label Text="{Binding CreatedText}"
                                           Style="{StaticResource MetaLabel}" />
                                    <Label Grid.Column="1"
                                           Text="{Binding ExpirationText}"
                                           Style="{StaticResource MetaLabel}"
                                           HorizontalTextAlignment="End" />
                                </Grid>
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                    <Button Text="复制链接"
                                            Style="{StaticResource SecondaryButton}"
                                            CommandParameter="{Binding .}"
                                            Clicked="OnCopyClicked" />
                                    <Button Grid.Column="1"
                                            Text="禁用"
                                            Style="{StaticResource DangerButton}"
                                            IsEnabled="{Binding CanDisable}"
                                            CommandParameter="{Binding .}"
                                            Clicked="OnDisableClicked" />
                                </Grid>
                            </VerticalStackLayout>
                        </Border>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
