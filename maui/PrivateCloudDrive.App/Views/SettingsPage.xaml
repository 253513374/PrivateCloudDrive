<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:loc="clr-namespace:PrivateCloudDrive.App.Localization"
             xmlns:shapes="clr-namespace:Microsoft.Maui.Controls.Shapes;assembly=Microsoft.Maui.Controls"
             x:Class="PrivateCloudDrive.App.Views.SettingsPage"
             Title="{x:Static loc:AppText.Settings}"
             Shell.NavBarIsVisible="False">
    <ScrollView>
        <VerticalStackLayout Padding="18,20,18,28"
                             Spacing="16">
            <Grid ColumnDefinitions="*,Auto"
                  ColumnSpacing="12">
                <VerticalStackLayout Spacing="4">
                    <Label Text="{x:Static loc:AppText.Settings}"
                           Style="{StaticResource PageTitleLabel}"
                           FontSize="28" />
                    <Label Text="账号、空间和私有部署状态"
                           Style="{StaticResource MetaLabel}"
                           FontSize="14" />
                </VerticalStackLayout>
                <Border Grid.Column="1"
                        HeightRequest="44"
                        WidthRequest="44"
                        Padding="8"
                        BackgroundColor="{AppThemeBinding Light={StaticResource PrimarySoftLight}, Dark={StaticResource PrimarySoftDark}}"
                        StrokeThickness="0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12" />
                    </Border.StrokeShape>
                    <Image Source="privateclouddrive_mark.png"
                           Aspect="AspectFit"
                           SemanticProperties.Description="PrivateCloudDrive" />
                </Border>
            </Grid>

            <Border Padding="18"
                    BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}"
                    Stroke="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="10" />
                </Border.StrokeShape>
                <Grid RowDefinitions="Auto,Auto"
                      RowSpacing="14">
                    <Grid ColumnDefinitions="Auto,*,Auto"
                          ColumnSpacing="14">
                        <Border HeightRequest="58"
                                WidthRequest="58"
                                BackgroundColor="{AppThemeBinding Light={StaticResource PrimarySoftLight}, Dark={StaticResource PrimarySoftDark}}"
                                StrokeThickness="0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12" />
                            </Border.StrokeShape>
                            <shapes:Path Aspect="Uniform"
                                         Stroke="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                                         StrokeThickness="1.9"
                                         StrokeLineCap="Round"
                                         StrokeLineJoin="Round"
                                         Data="M14,14 C17,14 19.5,11.5 19.5,8.5 C19.5,5.5 17,3 14,3 C11,3 8.5,5.5 8.5,8.5 C8.5,11.5 11,14 14,14 Z M5,26 C5.7,20.5 9,17.5 14,17.5 C19,17.5 22.3,20.5 23,26"
                                         HeightRequest="30"
                                         WidthRequest="30"
                                         HorizontalOptions="Center"
                                         VerticalOptions="Center" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1"
                                             Spacing="3"
                                             VerticalOptions="Center">
                            <Label Text="本机账号"
                                   FontFamily="OpenSansSemibold"
                                   FontSize="20"
                                   TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
                            <Label Text="账号密码登录始终可用"
                                   Style="{StaticResource MetaLabel}"
                                   LineBreakMode="WordWrap" />
                        </VerticalStackLayout>
                        <Border Grid.Column="2"
                                Padding="12,7"
                                BackgroundColor="{AppThemeBinding Light={StaticResource PrimarySoftLight}, Dark={StaticResource PrimarySoftDark}}"
                                StrokeThickness="0"
                                VerticalOptions="Center">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="18" />
                            </Border.StrokeShape>
                            <Label Text="私有云"
                                   FontFamily="OpenSansSemibold"
                                   FontSize="12"
                                   TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                        </Border>
                    </Grid>

                    <Border x:Name="SettingsStatePanel"
                            Grid.Row="1"
                            Padding="12"
                            BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceAltLight}, Dark={StaticResource SurfaceAltDark}}"
                            StrokeThickness="0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="8" />
                        </Border.StrokeShape>
                        <Grid ColumnDefinitions="Auto,*,Auto"
                              ColumnSpacing="10">
                            <ActivityIndicator x:Name="SettingsLoadingIndicator"
                                               WidthRequest="20"
                                               HeightRequest="20"
                                               Color="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                                               VerticalOptions="Center" />
                            <Label x:Name="SettingsStateLabel"
                                   Grid.Column="1"
                                   VerticalOptions="Center"
                                   FontSize="13"
                                   LineBreakMode="WordWrap"
                                   TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
                            <Button x:Name="SettingsRetryButton"
                                    Grid.Column="2"
                                    Text="{x:Static loc:AppText.Retry}"
                                    IsVisible="False"
                                    Style="{StaticResource SecondaryButton}"
                                    Padding="12,6"
                                    MinimumHeightRequest="36"
                                    Clicked="OnRetryClicked" />
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <Border Padding="18"
                    StrokeThickness="0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="10" />
                </Border.StrokeShape>
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0"
                                         EndPoint="1,1">
                        <GradientStop Color="{StaticResource PrimarySoftLight}" Offset="0.0" />
                        <GradientStop Color="{StaticResource Primary}" Offset="1.0" />
                    </LinearGradientBrush>
                </Border.Background>
                <VerticalStackLayout Spacing="12">
                    <Grid ColumnDefinitions="*,Auto"
                          ColumnSpacing="12">
                        <VerticalStackLayout Spacing="6">
                            <Label Text="存储空间"
                                   FontFamily="OpenSansSemibold"
                                   FontSize="17"
                                   TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
                            <Label x:Name="StorageUsageLabel"
                                   Text="正在读取容量"
                                   FontFamily="OpenSansSemibold"
                                   FontSize="26"
                                   TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}"
                                   LineBreakMode="WordWrap" />
                            <Label x:Name="StorageQuotaLabel"
                                   Text=""
                                   FontSize="13"
                                   TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}"
                                   LineBreakMode="WordWrap" />
                        </VerticalStackLayout>
                        <Button Grid.Column="1"
                                Text="{x:Static loc:AppText.Trash}"
                                BackgroundColor="{StaticResource SurfaceLight}"
                                TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}"
                                BorderWidth="1"
                                BorderColor="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}"
                                Padding="12,8"
                                MinimumHeightRequest="40"
                                VerticalOptions="End"
                                Clicked="OnTrashClicked" />
                    </Grid>
                    <ProgressBar x:Name="StorageProgressBar"
                                 Progress="0"
                                 HeightRequest="8"
                                 ProgressColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                                 BackgroundColor="#33FFFFFF" />
                </VerticalStackLayout>
            </Border>

            <VerticalStackLayout Spacing="10">
                <Label Text="常用管理"
                       Style="{StaticResource SectionTitleLabel}" />
                <Border Padding="0"
                        BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="10" />
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="0">
                        <Grid Padding="16,14"
                              ColumnDefinitions="Auto,*,Auto"
                              ColumnSpacing="14"
                              MinimumHeightRequest="74">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnTrashClicked" />
                            </Grid.GestureRecognizers>
                            <Border HeightRequest="42"
                                    WidthRequest="42"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource PrimarySoftLight}, Dark={StaticResource PrimarySoftDark}}"
                                    StrokeThickness="0"
                                    VerticalOptions="Center">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="9" />
                                </Border.StrokeShape>
                                <shapes:Path Aspect="Uniform"
                                             Stroke="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                                             StrokeThickness="1.9"
                                             StrokeLineCap="Round"
                                             StrokeLineJoin="Round"
                                             Data="M7,8 L21,8 M9,8 L10,24 L18,24 L19,8 M11,5 L17,5 L18,8"
                                             HeightRequest="24"
                                             WidthRequest="24"
                                             HorizontalOptions="Center"
                                             VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1"
                                                 Spacing="2"
                                                 VerticalOptions="Center">
                                <Label Text="{x:Static loc:AppText.Trash}"
                                       FontFamily="OpenSansSemibold"
                                       FontSize="16" />
                                <Label Text="查看已删除文件"
                                       Style="{StaticResource MetaLabel}" />
                            </VerticalStackLayout>
                            <Label Grid.Column="2"
                                   Text="›"
                                   FontSize="28"
                                   TextColor="{AppThemeBinding Light={StaticResource TextTertiaryLight}, Dark={StaticResource TextTertiaryDark}}"
                                   VerticalOptions="Center" />
                        </Grid>
                        <BoxView Margin="72,0,16,0"
                                 HeightRequest="1"
                                 Color="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}" />
                        <Grid Padding="16,14"
                              ColumnDefinitions="Auto,*,Auto"
                              ColumnSpacing="14"
                              MinimumHeightRequest="74">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnSharesClicked" />
                            </Grid.GestureRecognizers>
                            <Border HeightRequest="42"
                                    WidthRequest="42"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource PrimarySoftLight}, Dark={StaticResource PrimarySoftDark}}"
                                    StrokeThickness="0"
                                    VerticalOptions="Center">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="9" />
                                </Border.StrokeShape>
                                <shapes:Path Aspect="Uniform"
                                             Stroke="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                                             StrokeThickness="1.9"
                                             StrokeLineCap="Round"
                                             StrokeLineJoin="Round"
                                             Data="M8,8 L20,8 M8,14 L20,14 M8,20 L16,20 M6,4 L22,4 L22,24 L6,24 Z"
                                             HeightRequest="24"
                                             WidthRequest="24"
                                             HorizontalOptions="Center"
                                             VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1"
                                                 Spacing="2"
                                                 VerticalOptions="Center">
                                <Label Text="我的分享"
                                       FontFamily="OpenSansSemibold"
                                       FontSize="16" />
                                <Label Text="管理分享链接"
                                       Style="{StaticResource MetaLabel}" />
                            </VerticalStackLayout>
                            <Label Grid.Column="2"
                                   Text="›"
                                   FontSize="28"
                                   TextColor="{AppThemeBinding Light={StaticResource TextTertiaryLight}, Dark={StaticResource TextTertiaryDark}}"
                                   VerticalOptions="Center" />
                        </Grid>
                        <BoxView Margin="72,0,16,0"
                                 HeightRequest="1"
                                 Color="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}" />
                        <Grid Padding="16,14"
                              ColumnDefinitions="Auto,*,Auto"
                              ColumnSpacing="14"
                              MinimumHeightRequest="74">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnOperationLogsClicked" />
                            </Grid.GestureRecognizers>
                            <Border HeightRequest="42"
                                    WidthRequest="42"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource PrimarySoftLight}, Dark={StaticResource PrimarySoftDark}}"
                                    StrokeThickness="0"
                                    VerticalOptions="Center">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="9" />
                                </Border.StrokeShape>
                                <shapes:Path Aspect="Uniform"
                                             Stroke="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                                             StrokeThickness="1.9"
                                             StrokeLineCap="Round"
                                             StrokeLineJoin="Round"
                                             Data="M7,7 L21,7 M7,14 L21,14 M7,21 L16,21"
                                             HeightRequest="24"
                                             WidthRequest="24"
                                             HorizontalOptions="Center"
                                             VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1"
                                                 Spacing="2"
                                                 VerticalOptions="Center">
                                <Label Text="{x:Static loc:AppText.OperationLogs}"
                                       FontFamily="OpenSansSemibold"
                                       FontSize="16" />
                                <Label Text="登录与文件记录"
                                       Style="{StaticResource MetaLabel}" />
                            </VerticalStackLayout>
                            <Label Grid.Column="2"
                                   Text="›"
                                   FontSize="28"
                                   TextColor="{AppThemeBinding Light={StaticResource TextTertiaryLight}, Dark={StaticResource TextTertiaryDark}}"
                                   VerticalOptions="Center" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="10">
                <Label Text="登录方式"
                       Style="{StaticResource SectionTitleLabel}" />
                <Border Padding="0"
                        BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="10" />
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="0">
                        <Grid Padding="16,14"
                              ColumnDefinitions="Auto,*,Auto"
                              ColumnSpacing="14"
                              MinimumHeightRequest="82">
                            <Border HeightRequest="42"
                                    WidthRequest="42"
                                    BackgroundColor="#E9F8F0"
                                    StrokeThickness="0"
                                    VerticalOptions="Center">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="9" />
                                </Border.StrokeShape>
                                <Label Text="微"
                                       FontFamily="OpenSansSemibold"
                                       FontSize="17"
                                       TextColor="{StaticResource Primary}"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1"
                                                 Spacing="2"
                                                 VerticalOptions="Center">
                                <Label Text="{x:Static loc:AppText.Wechat}"
                                       FontFamily="OpenSansSemibold"
                                       FontSize="16" />
                                <Label x:Name="WechatStatusLabel"
                                       Text="{x:Static loc:AppText.Checking}"
                                       Style="{StaticResource MetaLabel}"
                                       LineBreakMode="WordWrap" />
                            </VerticalStackLayout>
                            <Grid Grid.Column="2"
                                  ColumnDefinitions="Auto,Auto,Auto"
                                  ColumnSpacing="8"
                                  VerticalOptions="Center">
                                <ActivityIndicator x:Name="WechatLoadingIndicator"
                                                   WidthRequest="20"
                                                   HeightRequest="20"
                                                   Color="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                                                   VerticalOptions="Center" />
                                <Button x:Name="WechatBindButton"
                                        Grid.Column="1"
                                        Text="{x:Static loc:AppText.BindWechat}"
                                        Style="{StaticResource SecondaryButton}"
                                        Padding="12,6"
                                        MinimumHeightRequest="36"
                                        IsVisible="False"
                                        Clicked="OnWechatBindClicked" />
                                <Button x:Name="WechatUnbindButton"
                                        Grid.Column="2"
                                        Text="{x:Static loc:AppText.Unbind}"
                                        Style="{StaticResource DangerButton}"
                                        Padding="12,6"
                                        MinimumHeightRequest="36"
                                        IsVisible="False"
                                        Clicked="OnWechatUnbindClicked" />
                            </Grid>
                        </Grid>
                        <BoxView Margin="72,0,16,0"
                                 HeightRequest="1"
                                 Color="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}" />
                        <Grid Padding="16,14"
                              ColumnDefinitions="Auto,*,Auto"
                              ColumnSpacing="14"
                              MinimumHeightRequest="82">
                            <Border HeightRequest="42"
                                    WidthRequest="42"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceAltLight}, Dark={StaticResource SurfaceAltDark}}"
                                    StrokeThickness="0"
                                    VerticalOptions="Center">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="9" />
                                </Border.StrokeShape>
                                <Label Text="G"
                                       FontFamily="OpenSansSemibold"
                                       FontSize="18"
                                       TextColor="{AppThemeBinding Light={StaticResource Gray400}, Dark={StaticResource TextSecondaryDark}}"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1"
                                                 Spacing="2"
                                                 VerticalOptions="Center">
                                <Label Text="{x:Static loc:AppText.Google}"
                                       FontFamily="OpenSansSemibold"
                                       FontSize="16" />
                                <Label x:Name="GoogleStatusLabel"
                                       Text="{x:Static loc:AppText.Checking}"
                                       Style="{StaticResource MetaLabel}"
                                       LineBreakMode="WordWrap" />
                            </VerticalStackLayout>
                            <Grid Grid.Column="2"
                                  ColumnDefinitions="Auto,Auto,Auto"
                                  ColumnSpacing="8"
                                  VerticalOptions="Center">
                                <ActivityIndicator x:Name="GoogleLoadingIndicator"
                                                   WidthRequest="20"
                                                   HeightRequest="20"
                                                   Color="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                                                   VerticalOptions="Center" />
                                <Button x:Name="GoogleBindButton"
                                        Grid.Column="1"
                                        Text="{x:Static loc:AppText.BindGoogle}"
                                        Style="{StaticResource SecondaryButton}"
                                        Padding="12,6"
                                        MinimumHeightRequest="36"
                                        IsVisible="False"
                                        Clicked="OnGoogleBindClicked" />
                                <Button x:Name="GoogleUnbindButton"
                                        Grid.Column="2"
                                        Text="{x:Static loc:AppText.Unbind}"
                                        Style="{StaticResource DangerButton}"
                                        Padding="12,6"
                                        MinimumHeightRequest="36"
                                        IsVisible="False"
                                        Clicked="OnGoogleUnbindClicked" />
                            </Grid>
                        </Grid>
                        <BoxView Margin="72,0,16,0"
                                 HeightRequest="1"
                                 Color="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}" />
                        <Grid Padding="16,14"
                              ColumnDefinitions="Auto,*,Auto"
                              ColumnSpacing="14"
                              MinimumHeightRequest="82">
                            <Border HeightRequest="42"
                                    WidthRequest="42"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceAltLight}, Dark={StaticResource SurfaceAltDark}}"
                                    StrokeThickness="0"
                                    VerticalOptions="Center">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="9" />
                                </Border.StrokeShape>
                                <Label Text="GH"
                                       FontFamily="OpenSansSemibold"
                                       FontSize="14"
                                       TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource TextPrimaryDark}}"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1"
                                                 Spacing="2"
                                                 VerticalOptions="Center">
                                <Label Text="{x:Static loc:AppText.GitHub}"
                                       FontFamily="OpenSansSemibold"
                                       FontSize="16" />
                                <Label x:Name="GitHubStatusLabel"
                                       Text="{x:Static loc:AppText.Checking}"
                                       Style="{StaticResource MetaLabel}"
                                       LineBreakMode="WordWrap" />
                            </VerticalStackLayout>
                            <Grid Grid.Column="2"
                                  ColumnDefinitions="Auto,Auto,Auto"
                                  ColumnSpacing="8"
                                  VerticalOptions="Center">
                                <ActivityIndicator x:Name="GitHubLoadingIndicator"
                                                   WidthRequest="20"
                                                   HeightRequest="20"
                                                   Color="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                                                   VerticalOptions="Center" />
                                <Button x:Name="GitHubBindButton"
                                        Grid.Column="1"
                                        Text="{x:Static loc:AppText.BindGitHub}"
                                        Style="{StaticResource SecondaryButton}"
                                        Padding="12,6"
                                        MinimumHeightRequest="36"
                                        IsVisible="False"
                                        Clicked="OnGitHubBindClicked" />
                                <Button x:Name="GitHubUnbindButton"
                                        Grid.Column="2"
                                        Text="{x:Static loc:AppText.Unbind}"
                                        Style="{StaticResource DangerButton}"
                                        Padding="12,6"
                                        MinimumHeightRequest="36"
                                        IsVisible="False"
                                        Clicked="OnGitHubUnbindClicked" />
                            </Grid>
                        </Grid>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="10">
                <Label Text="服务与安全"
                       Style="{StaticResource SectionTitleLabel}" />
                <Border Padding="0"
                        BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="10" />
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="0">
                        <Grid Padding="16,14"
                              ColumnDefinitions="*,Auto"
                              ColumnSpacing="12"
                              MinimumHeightRequest="70">
                            <VerticalStackLayout Spacing="2"
                                                 VerticalOptions="Center">
                                <Label Text="{x:Static loc:AppText.Server}"
                                       FontFamily="OpenSansSemibold"
                                       FontSize="16" />
                                <Label Text="{Binding ApiBaseUrl}"
                                       Style="{StaticResource MetaLabel}"
                                       LineBreakMode="TailTruncation" />
                            </VerticalStackLayout>
                            <Label Grid.Column="1"
                                   Text="›"
                                   FontSize="28"
                                   TextColor="{AppThemeBinding Light={StaticResource TextTertiaryLight}, Dark={StaticResource TextTertiaryDark}}"
                                   VerticalOptions="Center" />
                        </Grid>
                        <BoxView Margin="16,0"
                                 HeightRequest="1"
                                 Color="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}" />
                        <Grid Padding="16,14"
                              MinimumHeightRequest="86">
                            <VerticalStackLayout Spacing="3">
                                <Label Text="系统健康"
                                       FontFamily="OpenSansSemibold"
                                       FontSize="16" />
                                <Label x:Name="SystemHealthStatusLabel"
                                       Text="正在读取系统健康状态"
                                       FontFamily="OpenSansSemibold"
                                       FontSize="14"
                                       TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}"
                                       LineBreakMode="WordWrap" />
                                <Label x:Name="SystemHealthDetailLabel"
                                       Text=""
                                       Style="{StaticResource MetaLabel}"
                                       LineBreakMode="WordWrap" />
                                <Label x:Name="SystemHealthDiagnosticsLabel"
                                       Text=""
                                       Style="{StaticResource MetaLabel}"
                                       LineBreakMode="WordWrap" />
                            </VerticalStackLayout>
                        </Grid>
                        <BoxView Margin="16,0"
                                 HeightRequest="1"
                                 Color="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}" />
                        <Grid Padding="16,14"
                              MinimumHeightRequest="70">
                            <VerticalStackLayout Spacing="2">
                                <Label Text="{x:Static loc:AppText.Security}"
                                       FontFamily="OpenSansSemibold"
                                       FontSize="16" />
                                <Label Text="{x:Static loc:AppText.LocalSessionProtected}"
                                       Style="{StaticResource MetaLabel}"
                                       LineBreakMode="WordWrap" />
                            </VerticalStackLayout>
                        </Grid>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>

            <Button Text="{x:Static loc:AppText.SignOut}"
                    Style="{StaticResource DangerButton}"
                    HeightRequest="50"
                    Clicked="OnSignOutClicked" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
