<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PrivateCloudDrive.App.Views.SettingsPage"
             Title="Settings">
    <Grid Padding="18" RowDefinitions="Auto,Auto,*" RowSpacing="16">
        <VerticalStackLayout Spacing="4">
            <Label Text="Settings" Style="{StaticResource PageTitleLabel}" />
            <Label Text="Account, server, and app preferences." Style="{StaticResource MetaLabel}" />
        </VerticalStackLayout>

        <Border x:Name="SettingsStatePanel"
                Grid.Row="1"
                Padding="14"
                BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}"
                StrokeThickness="1">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="8" />
            </Border.StrokeShape>
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                <ActivityIndicator x:Name="SettingsLoadingIndicator"
                                   WidthRequest="20"
                                   HeightRequest="20"
                                   Color="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                <Label x:Name="SettingsStateLabel"
                       Grid.Column="1"
                       VerticalOptions="Center"
                       FontSize="13"
                       LineBreakMode="WordWrap"
                       TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
                <Button x:Name="SettingsRetryButton"
                        Grid.Column="2"
                        Text="Retry"
                        IsVisible="False"
                        Style="{StaticResource SecondaryButton}"
                        Clicked="OnRetryClicked" />
            </Grid>
        </Border>

        <VerticalStackLayout Grid.Row="2" Spacing="12">
            <Border Padding="16"
                    BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="8" />
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="6">
                    <Label Text="Server" Style="{StaticResource SectionTitleLabel}" />
                    <Label Text="{Binding ApiBaseUrl}" Style="{StaticResource MetaLabel}" />
                </VerticalStackLayout>
            </Border>

            <Border Padding="16"
                    BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="8" />
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="6">
                    <Label Text="Security" Style="{StaticResource SectionTitleLabel}" />
                    <Label Text="Local session is protected on this device. Sign out to remove access." Style="{StaticResource MetaLabel}" LineBreakMode="WordWrap" />
                </VerticalStackLayout>
            </Border>

            <Border Padding="16"
                    BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="8" />
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="10">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="WeChat" Style="{StaticResource SectionTitleLabel}" />
                            <Label x:Name="WechatStatusLabel"
                                   Text="Checking"
                                   Style="{StaticResource MetaLabel}"
                                   LineBreakMode="WordWrap" />
                        </VerticalStackLayout>
                        <ActivityIndicator x:Name="WechatLoadingIndicator"
                                           Grid.Column="1"
                                           WidthRequest="20"
                                           HeightRequest="20"
                                           Color="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                    </Grid>
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                        <Button x:Name="WechatBindButton"
                                Text="Bind WeChat"
                                Style="{StaticResource SecondaryButton}"
                                IsVisible="False"
                                Clicked="OnWechatBindClicked" />
                        <Button x:Name="WechatUnbindButton"
                                Grid.Column="1"
                                Text="Unbind"
                                Style="{StaticResource DangerButton}"
                                IsVisible="False"
                                Clicked="OnWechatUnbindClicked" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <Button Text="Operation logs"
                    Style="{StaticResource SecondaryButton}"
                    Clicked="OnOperationLogsClicked" />

            <Button Text="Sign out"
                    Style="{StaticResource DangerButton}"
                    Clicked="OnSignOutClicked" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>
