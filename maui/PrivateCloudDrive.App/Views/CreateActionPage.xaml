<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PrivateCloudDrive.App.Views.CreateActionPage"
             Title="新建"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource PageBackgroundDark}">
    <Grid RowDefinitions="*,Auto"
          Padding="18,24,18,18">
        <VerticalStackLayout Spacing="10">
            <Label Text="备份中心"
                   Style="{StaticResource PageTitleLabel}" />
            <Label Text="把手机照片和本机文件备份到你配置的私有服务器，并在同一入口查看队列、容量健康和恢复说明。"
                   Style="{StaticResource MetaLabel}"
                   LineBreakMode="WordWrap" />
        </VerticalStackLayout>

        <Border Grid.Row="1"
                Padding="20"
                BackgroundColor="{StaticResource SurfaceLight}"
                Stroke="{StaticResource BorderLight}"
                StrokeThickness="1">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="24" />
            </Border.StrokeShape>
            <VerticalStackLayout Spacing="14">
                <Grid ColumnDefinitions="*,Auto">
                    <VerticalStackLayout Spacing="2">
                            <Label Text="备份"
                               Style="{StaticResource PageTitleLabel}"
                               FontSize="24" />
                        <Label Text="选择要备份到私有服务器的来源"
                               Style="{StaticResource MetaLabel}" />
                    </VerticalStackLayout>
                    <Button Grid.Column="1"
                            Text="关闭"
                            Style="{StaticResource GhostButton}"
                            Clicked="OnCloseClicked" />
                </Grid>

                <Button Text="备份照片/视频"
                        Style="{StaticResource SecondaryButton}"
                        HorizontalOptions="Fill"
                        Clicked="OnBackupMediaClicked" />
                <Button Text="查看备份队列与失败重试"
                        Style="{StaticResource SecondaryButton}"
                        HorizontalOptions="Fill"
                        Clicked="OnBackupQueueClicked" />
                <Button Text="备份本机文件"
                        HorizontalOptions="Fill"
                        Clicked="OnBackupFilesClicked" />
                <Button Text="容量/健康与恢复说明"
                        Style="{StaticResource SecondaryButton}"
                        HorizontalOptions="Fill"
                        Clicked="OnStorageHealthClicked" />
                <Button Text="恢复边界说明"
                        Style="{StaticResource SecondaryButton}"
                        HorizontalOptions="Fill"
                        Clicked="OnRestoreGuideClicked" />
                <Button Text="扫描文档（即将推出）"
                        Style="{StaticResource SecondaryButton}"
                        HorizontalOptions="Fill"
                        Clicked="OnComingSoonClicked" />
                <Button Text="新建文件夹"
                        Style="{StaticResource SecondaryButton}"
                        HorizontalOptions="Fill"
                        Clicked="OnNewFolderClicked" />
                <Button Text="从链接导入（探索）"
                        Style="{StaticResource SecondaryButton}"
                        HorizontalOptions="Fill"
                        Clicked="OnComingSoonClicked" />
            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentPage>
