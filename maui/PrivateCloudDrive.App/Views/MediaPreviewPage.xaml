<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="PrivateCloudDrive.App.Views.MediaPreviewPage"
             Title="{Binding FileName}">
    <Grid Padding="18" RowDefinitions="Auto,*" RowSpacing="16">
        <VerticalStackLayout Spacing="4">
            <Label Text="{Binding FileName}"
                   Style="{StaticResource PageTitleLabel}" />
            <Label Text="{Binding MediaKind}"
                   Style="{StaticResource MetaLabel}" />
        </VerticalStackLayout>

        <Grid Grid.Row="1">
            <ActivityIndicator x:Name="LoadingIndicator"
                               IsRunning="True"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
            <Image x:Name="PreviewImage"
                   Aspect="AspectFit"
                   IsVisible="False"
                   BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}" />
            <toolkit:MediaElement x:Name="VideoPlayer"
                                  Aspect="AspectFit"
                                  ShouldAutoPlay="False"
                                  ShouldKeepScreenOn="True"
                                  ShouldShowPlaybackControls="True"
                                  IsVisible="False"
                                  BackgroundColor="{AppThemeBinding Light=#000000, Dark=#000000}" />
            <VerticalStackLayout x:Name="ErrorPanel"
                                 IsVisible="False"
                                 Spacing="10"
                                 HorizontalOptions="Center"
                                 VerticalOptions="Center"
                                 MaximumWidthRequest="360">
                <Label x:Name="ErrorLabel"
                       HorizontalTextAlignment="Center"
                       LineBreakMode="WordWrap"
                       TextColor="{StaticResource Danger}" />
                <Button Text="Retry"
                        Style="{StaticResource SecondaryButton}"
                        Clicked="OnRetryClicked" />
            </VerticalStackLayout>
        </Grid>
    </Grid>
</ContentPage>
