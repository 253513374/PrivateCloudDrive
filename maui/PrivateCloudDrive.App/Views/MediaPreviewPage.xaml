<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:loc="clr-namespace:PrivateCloudDrive.App.Localization"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="PrivateCloudDrive.App.Views.MediaPreviewPage"
             Title="{Binding FileName}">
    <Grid Padding="18" RowDefinitions="Auto,*,Auto" RowSpacing="14">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
            <VerticalStackLayout Spacing="4">
                <Label Text="{Binding FileName}"
                       Style="{StaticResource PageTitleLabel}"
                       LineBreakMode="TailTruncation" />
                <Label Text="{Binding PreviewMetaText}"
                       Style="{StaticResource MetaLabel}" />
            </VerticalStackLayout>
            <Button Grid.Column="1"
                    Text="{x:Static loc:AppText.Refresh}"
                    Style="{StaticResource SecondaryButton}"
                    VerticalOptions="Center"
                    Clicked="OnRetryClicked" />
        </Grid>

        <Border Grid.Row="1"
                BackgroundColor="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource Black}}"
                StrokeThickness="0">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="8" />
            </Border.StrokeShape>
            <Grid>
            <ActivityIndicator x:Name="LoadingIndicator"
                               IsRunning="True"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
            <Image x:Name="PreviewImage"
                   Aspect="AspectFit"
                   IsVisible="False"
                   BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}" />
            <toolkit:MediaElement x:Name="VideoPlayer"
                                  Aspect="AspectFit"
                                  ShouldAutoPlay="False"
                                  ShouldKeepScreenOn="True"
                                  ShouldShowPlaybackControls="True"
                                  IsVisible="False"
                                  BackgroundColor="{AppThemeBinding Light=#000000, Dark=#000000}" />
            <VerticalStackLayout x:Name="StatusPanel"
                                 IsVisible="False"
                                 Spacing="10"
                                 HorizontalOptions="Center"
                                 VerticalOptions="Center"
                                 MaximumWidthRequest="360">
                <Label x:Name="StatusLabel"
                       HorizontalTextAlignment="Center"
                       LineBreakMode="WordWrap"
                       TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
                <Button x:Name="RetryProcessingButton"
                        Text="重新处理"
                        Style="{StaticResource SecondaryButton}"
                        Clicked="OnRetryProcessingClicked" />
            </VerticalStackLayout>
            <VerticalStackLayout x:Name="ErrorPanel"
                                 IsVisible="False"
                                 Spacing="10"
                                 HorizontalOptions="Center"
                                 VerticalOptions="Center"
                                 MaximumWidthRequest="360">
                <Label x:Name="ErrorLabel"
                       HorizontalTextAlignment="Center"
                       LineBreakMode="WordWrap"
                       TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
                <Button Text="{x:Static loc:AppText.Retry}"
                        Style="{StaticResource SecondaryButton}"
                        Clicked="OnRetryClicked" />
            </VerticalStackLayout>
            </Grid>
        </Border>

        <Border Grid.Row="2"
                Padding="14"
                BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}"
                StrokeThickness="1">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="8" />
            </Border.StrokeShape>
            <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="8">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                    <VerticalStackLayout Spacing="2">
                        <Label Text="{Binding FileName}" FontAttributes="Bold" FontSize="15" LineBreakMode="TailTruncation" />
                        <Label Text="{Binding PreviewDetailText}" Style="{StaticResource MetaLabel}" LineBreakMode="TailTruncation" />
                    </VerticalStackLayout>
                    <Border Grid.Column="1"
                            Padding="8,3"
                            BackgroundColor="{StaticResource Primary}"
                            StrokeThickness="0"
                            VerticalOptions="Center">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="8" />
                        </Border.StrokeShape>
                        <Label Text="{Binding MediaKindText}" FontSize="11" TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
                    </Border>
                </Grid>
                <Label Grid.Row="1"
                       Text="{Binding PreviewProcessText}"
                       Style="{StaticResource MetaLabel}"
                       LineBreakMode="WordWrap" />
                <Button x:Name="RetryProcessingDetailButton"
                        Grid.Row="2"
                        Text="重新处理"
                        Style="{StaticResource SecondaryButton}"
                        IsVisible="{Binding CanRetryProcessing}"
                        Clicked="OnRetryProcessingClicked" />
            </Grid>
        </Border>
    </Grid>
</ContentPage>
