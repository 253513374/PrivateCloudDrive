<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="PrivateCloudDrive.App.Views.MediaPreviewPage"
             Title="{Binding FileName}"
             BackgroundColor="{AppThemeBinding Light=#F7F9FC, Dark=#111827}">
    <Grid Padding="18" RowDefinitions="Auto,*" RowSpacing="16">
        <VerticalStackLayout Spacing="4">
            <Label Text="{Binding FileName}"
                   FontAttributes="Bold"
                   FontSize="22"
                   TextColor="{AppThemeBinding Light=#17202A, Dark=#F9FAFB}" />
            <Label Text="{Binding MediaKind}"
                   FontSize="13"
                   TextColor="{AppThemeBinding Light=#607083, Dark=#CBD5E1}" />
        </VerticalStackLayout>

        <Grid Grid.Row="1">
            <ActivityIndicator x:Name="LoadingIndicator"
                               IsRunning="True"
                               Color="#1F7A5C"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
            <Image x:Name="PreviewImage"
                   Aspect="AspectFit"
                   IsVisible="False"
                   BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1F2937}" />
            <toolkit:MediaElement x:Name="VideoPlayer"
                                  Aspect="AspectFit"
                                  ShouldAutoPlay="False"
                                  ShouldKeepScreenOn="True"
                                  ShouldShowPlaybackControls="True"
                                  IsVisible="False"
                                  BackgroundColor="{AppThemeBinding Light=#000000, Dark=#000000}" />
            <Label x:Name="ErrorLabel"
                   IsVisible="False"
                   HorizontalOptions="Center"
                   VerticalOptions="Center"
                   HorizontalTextAlignment="Center"
                   TextColor="#B42318" />
        </Grid>
    </Grid>
</ContentPage>
