<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:loc="clr-namespace:PrivateCloudDrive.App.Localization"
             xmlns:models="clr-namespace:PrivateCloudDrive.App.Models"
             xmlns:shapes="clr-namespace:Microsoft.Maui.Controls.Shapes;assembly=Microsoft.Maui.Controls"
             x:Class="PrivateCloudDrive.App.Views.MediaAlbumsPage"
             Title="{x:Static loc:AppText.Albums}"
             Shell.NavBarIsVisible="False">
    <Grid Padding="18,18,18,16"
          RowDefinitions="Auto,Auto,Auto,*"
          RowSpacing="10">
        <Grid ColumnDefinitions="*,Auto"
              ColumnSpacing="12">
            <VerticalStackLayout Spacing="4">
                <Label Text="{x:Static loc:AppText.Albums}"
                       Style="{StaticResource PageTitleLabel}"
                       FontSize="28" />
                <Label Text="把一组媒体整理成更容易回看的集合"
                       Style="{StaticResource MetaLabel}"
                       FontSize="14"
                       LineBreakMode="WordWrap" />
            </VerticalStackLayout>
            <Button Grid.Column="1"
                    Text="{x:Static loc:AppText.Refresh}"
                    Style="{StaticResource SecondaryButton}"
                    Padding="14,8"
                    HeightRequest="46"
                    WidthRequest="86"
                    VerticalOptions="Center"
                    Clicked="OnRefreshClicked" />
        </Grid>

        <Border Grid.Row="1"
                Padding="14"
                BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}"
                Stroke="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="10" />
            </Border.StrokeShape>
            <Grid ColumnDefinitions="Auto,*,Auto"
                  ColumnSpacing="14">
                <Border HeightRequest="50"
                        WidthRequest="50"
                        BackgroundColor="{AppThemeBinding Light={StaticResource PrimarySoftLight}, Dark={StaticResource PrimarySoftDark}}"
                        StrokeThickness="0"
                        VerticalOptions="Center">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12" />
                    </Border.StrokeShape>
                    <shapes:Path Aspect="Uniform"
                                 Stroke="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                                 StrokeThickness="1.9"
                                 StrokeLineCap="Round"
                                 StrokeLineJoin="Round"
                                 Data="M7,7 L21,7 L21,23 L7,23 Z M10,11 L18,11 M10,15 L18,15 M10,19 L15,19 M4,11 L7,11 M4,16 L7,16 M4,21 L7,21"
                                 HeightRequest="30"
                                 WidthRequest="30"
                                 HorizontalOptions="Center"
                                 VerticalOptions="Center" />
                </Border>
                <VerticalStackLayout Grid.Column="1"
                                     Spacing="3"
                                     VerticalOptions="Center">
                    <Label Text="{Binding AlbumCountText}"
                           FontFamily="DeliusSwashCaps"
                           FontSize="22"
                           TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
                    <Label Text="{Binding AlbumSummaryText}"
                           Style="{StaticResource MetaLabel}"
                           LineBreakMode="WordWrap" />
                </VerticalStackLayout>
                <Button Grid.Column="2"
                        Text="新建"
                        Padding="14,8"
                        HeightRequest="44"
                        WidthRequest="86"
                        VerticalOptions="Center"
                        Clicked="OnCreateClicked" />
            </Grid>
        </Border>

        <Border x:Name="StatePanel"
                Grid.Row="2"
                Padding="14"
                IsVisible="False"
                BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}"
                Stroke="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="10" />
            </Border.StrokeShape>
            <Grid ColumnDefinitions="Auto,*"
                  ColumnSpacing="10">
                <ActivityIndicator x:Name="LoadingIndicator"
                                   WidthRequest="20"
                                   HeightRequest="20"
                                   Color="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                <Label x:Name="StateLabel"
                       Grid.Column="1"
                       VerticalOptions="Center"
                       FontSize="13"
                       LineBreakMode="WordWrap"
                       TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
            </Grid>
        </Border>

        <CollectionView x:Name="AlbumsCollectionView"
                        Grid.Row="3"
                        ItemsSource="{Binding AlbumCards}"
                        SelectionMode="Single"
                        SelectionChanged="OnAlbumSelected">
            <CollectionView.ItemsLayout>
                <GridItemsLayout Orientation="Vertical"
                                 Span="2"
                                 HorizontalItemSpacing="10"
                                 VerticalItemSpacing="10" />
            </CollectionView.ItemsLayout>
            <CollectionView.EmptyView>
                <Border Padding="20"
                        BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}"
                        VerticalOptions="Start"
                        HeightRequest="220"
                        Stroke="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="10" />
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="12"
                                         HorizontalOptions="Center"
                                         VerticalOptions="Center">
                        <Border HeightRequest="54"
                                WidthRequest="54"
                                BackgroundColor="{AppThemeBinding Light={StaticResource PrimarySoftLight}, Dark={StaticResource PrimarySoftDark}}"
                                StrokeThickness="0"
                                HorizontalOptions="Center">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12" />
                            </Border.StrokeShape>
                            <shapes:Path Aspect="Uniform"
                                         Stroke="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                                         StrokeThickness="1.9"
                                         StrokeLineCap="Round"
                                         StrokeLineJoin="Round"
                                         Data="M7,7 L21,7 L21,23 L7,23 Z M10,12 L18,12 M10,16 L18,16 M10,20 L15,20"
                                         HeightRequest="28"
                                         WidthRequest="28"
                                         HorizontalOptions="Center"
                                         VerticalOptions="Center" />
                        </Border>
                        <Label Text="暂无相册"
                               Style="{StaticResource SectionTitleLabel}"
                               HorizontalTextAlignment="Center" />
                        <Label Text="创建相册，把图片和视频整理成一组。"
                               Style="{StaticResource MetaLabel}"
                               HorizontalTextAlignment="Center"
                               LineBreakMode="WordWrap" />
                        <Button Text="新建相册"
                                Clicked="OnCreateClicked" />
                    </VerticalStackLayout>
                </Border>
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:MediaAlbumCard">
                    <Border BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}"
                            Stroke="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="10" />
                        </Border.StrokeShape>
                        <Grid RowDefinitions="124,Auto">
                            <Grid BackgroundColor="{AppThemeBinding Light={StaticResource PrimarySoftLight}, Dark={StaticResource PrimarySoftDark}}">
                                <Image Source="{Binding CoverSource}"
                                       Aspect="AspectFill"
                                       IsVisible="{Binding HasCover}" />
                                <VerticalStackLayout IsVisible="{Binding ShowPlaceholder}"
                                                     Spacing="4"
                                                     HorizontalOptions="Center"
                                                     VerticalOptions="Center">
                                    <shapes:Path Aspect="Uniform"
                                                 Stroke="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                                                 StrokeThickness="1.9"
                                                 StrokeLineCap="Round"
                                                 StrokeLineJoin="Round"
                                                 Data="M5,8 L23,8 L23,22 L5,22 Z M8,19 L12,15 L15,18 L17,16 L21,20"
                                                 HeightRequest="30"
                                                 WidthRequest="30"
                                                 HorizontalOptions="Center" />
                                    <Label Text="{Binding ItemsCountText}"
                                           FontSize="12"
                                           TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                                           HorizontalTextAlignment="Center" />
                                </VerticalStackLayout>
                            </Grid>
                            <VerticalStackLayout Grid.Row="1"
                                                 Padding="12"
                                                 Spacing="4">
                                <Label Text="{Binding Name}"
                                       FontFamily="DeliusSwashCaps"
                                       FontSize="16"
                                       TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}"
                                       LineBreakMode="TailTruncation" />
                                <Label Text="{Binding SummaryText}"
                                       Style="{StaticResource MetaLabel}"
                                       LineBreakMode="TailTruncation" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
