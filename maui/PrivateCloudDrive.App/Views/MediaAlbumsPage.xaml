<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:PrivateCloudDrive.App.Models"
             x:Class="PrivateCloudDrive.App.Views.MediaAlbumsPage"
             Title="相册">
    <Grid Padding="18" RowDefinitions="Auto,Auto,*" RowSpacing="14">
        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
            <VerticalStackLayout Spacing="4">
                <Label Text="相册" Style="{StaticResource PageTitleLabel}" />
                <Label Text="{Binding AlbumCountText}" Style="{StaticResource MetaLabel}" />
            </VerticalStackLayout>
            <Button Grid.Column="1"
                    Text="新建"
                    TextColor="White"
                    Clicked="OnCreateClicked" />
            <Button Grid.Column="2"
                    Text="刷新"
                    Style="{StaticResource SecondaryButton}"
                    Clicked="OnRefreshClicked" />
        </Grid>

        <Border x:Name="StatePanel"
                Grid.Row="1"
                Padding="14"
                IsVisible="False"
                BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}"
                StrokeThickness="1">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="8" />
            </Border.StrokeShape>
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                <ActivityIndicator x:Name="LoadingIndicator"
                                   WidthRequest="20"
                                   HeightRequest="20"
                                   Color="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                <Label x:Name="StateLabel"
                       Grid.Column="1"
                       VerticalOptions="Center"
                       FontSize="13"
                       LineBreakMode="WordWrap" />
            </Grid>
        </Border>

        <CollectionView x:Name="AlbumsCollectionView"
                        Grid.Row="2"
                        ItemsSource="{Binding Albums}"
                        SelectionMode="Single"
                        SelectionChanged="OnAlbumSelected">
            <CollectionView.EmptyView>
                <Border Padding="18"
                        BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}"
                        StrokeThickness="1">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="8" />
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="6" HorizontalOptions="Center" VerticalOptions="Center">
                        <Label Text="暂无相册" Style="{StaticResource SectionTitleLabel}" HorizontalTextAlignment="Center" />
                        <Label Text="新建相册后，可以把最近的图片和视频加入其中。" Style="{StaticResource MetaLabel}" HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </Border>
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:MediaAlbum">
                    <Grid Padding="0,0,0,10">
                        <Border Padding="14"
                                BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}"
                                StrokeThickness="1">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="8" />
                            </Border.StrokeShape>
                            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="12">
                                <Label Text="{Binding Name}" FontAttributes="Bold" FontSize="16" />
                                <Label Grid.Row="1" Text="{Binding Description}" Style="{StaticResource MetaLabel}" LineBreakMode="TailTruncation" />
                                <Label Grid.Column="1" Grid.RowSpan="2" Text="{Binding ItemsCount, StringFormat='{0} 项'}" Style="{StaticResource MetaLabel}" VerticalOptions="Center" />
                            </Grid>
                        </Border>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
