<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PrivateCloudDrive.App.Views.AdminUserManagementPage"
             Title="用户管理"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource PageBackgroundDark}">
    <ScrollView>
        <VerticalStackLayout Padding="18,22,18,28" Spacing="16">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                <Button Text="‹"
                        Style="{StaticResource GhostButton}"
                        WidthRequest="46"
                        Clicked="OnBackClicked" />
                <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                    <Label Text="用户管理" Style="{StaticResource PageTitleLabel}" />
                    <Label x:Name="PageSubtitle" Text="管理员 · 管理当前私有备份服务器的所有用户" Style="{StaticResource MetaLabel}" />
                </VerticalStackLayout>
            </Grid>

            <Border x:Name="StatePanel"
                    Padding="14"
                    IsVisible="False"
                    BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}"
                    StrokeThickness="1">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="8" />
                </Border.StrokeShape>
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                    <ActivityIndicator x:Name="LoadingIndicator"
                                       WidthRequest="20" HeightRequest="20"
                                       Color="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                    <Label x:Name="StateLabel"
                           Grid.Column="1" VerticalOptions="Center"
                           FontSize="13" LineBreakMode="WordWrap" />
                    <Button x:Name="RetryButton"
                            Grid.Column="2" Text="重试"
                            IsVisible="False"
                            Style="{StaticResource SecondaryButton}"
                            Padding="12,6" MinimumHeightRequest="36"
                            Clicked="OnRefreshClicked" />
                </Grid>
            </Border>

            <Label Text="此页面用于管理员查看和管理当前私有备份服务器的注册用户。
包含用户名称、邮箱、角色和账户状态。
详细增删改功能需登录 Web 管理面板完成。"
                   Style="{StaticResource MetaLabel}"
                   LineBreakMode="WordWrap" />

            <CollectionView ItemsSource="{Binding Users}"
                            SelectionMode="None">
                <CollectionView.EmptyView>
                    <Border Padding="18"
                            BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}"
                            StrokeThickness="1">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="8" />
                        </Border.StrokeShape>
                        <VerticalStackLayout Spacing="6" HorizontalOptions="Center" VerticalOptions="Center" MinimumHeightRequest="200">
                            <Label Text="暂无用户数据" Style="{StaticResource SectionTitleLabel}" HorizontalTextAlignment="Center" />
                            <Label Text="连接到私有备份服务器后，用户列表将显示在这里。"
                                   Style="{StaticResource MetaLabel}" HorizontalTextAlignment="Center" LineBreakMode="WordWrap" />
                        </VerticalStackLayout>
                    </Border>
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="0,0,0,10">
                            <Border Padding="14"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}"
                                    StrokeThickness="1">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="8" />
                                </Border.StrokeShape>
                                <Grid ColumnDefinitions="44,*,Auto" ColumnSpacing="12">
                                    <Border HeightRequest="44" WidthRequest="44"
                                            BackgroundColor="{AppThemeBinding Light={StaticResource PrimarySoftLight}, Dark={StaticResource PrimarySoftDark}}"
                                            StrokeThickness="0" VerticalOptions="Center">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="10" />
                                        </Border.StrokeShape>
                                        <Label Text="U" FontAttributes="Bold" FontSize="16"
                                               HorizontalOptions="Center" VerticalOptions="Center"
                                               TextColor="{StaticResource Primary}" />
                                    </Border>
                                    <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                        <Label Text="{Binding UserName}" FontAttributes="Bold" FontSize="16" LineBreakMode="TailTruncation" />
                                        <Label Text="{Binding Email}" FontSize="13" LineBreakMode="TailTruncation"
                                               TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                                    </VerticalStackLayout>
                                    <Label Grid.Column="2" Text="{Binding RolesText}"
                                           FontSize="12" VerticalOptions="Center"
                                           TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                                </Grid>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
