<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Open Design dark visual system. Light aliases intentionally map to dark tokens. -->
    <Color x:Key="PageBackgroundLight">#050912</Color>
    <Color x:Key="PageBackgroundDark">#050912</Color>

    <Color x:Key="SurfaceLight">#0B1220</Color>
    <Color x:Key="SurfaceDark">#0B1220</Color>
    <Color x:Key="SurfaceAltLight">#091121</Color>
    <Color x:Key="SurfaceAltDark">#091121</Color>
    <Color x:Key="SurfaceRaisedLight">#111A2E</Color>
    <Color x:Key="SurfaceRaisedDark">#111A2E</Color>

    <Color x:Key="TextPrimaryLight">#F6F8FF</Color>
    <Color x:Key="TextPrimaryDark">#F6F8FF</Color>
    <Color x:Key="TextSecondaryLight">#B8C3D9</Color>
    <Color x:Key="TextSecondaryDark">#B8C3D9</Color>
    <Color x:Key="TextTertiaryLight">#6F7C96</Color>
    <Color x:Key="TextTertiaryDark">#6F7C96</Color>

    <Color x:Key="BorderLight">#1D2A42</Color>
    <Color x:Key="BorderDark">#1D2A42</Color>
    <Color x:Key="DividerLight">#162238</Color>
    <Color x:Key="DividerDark">#162238</Color>

    <Color x:Key="Primary">#1C7DFF</Color>
    <Color x:Key="PrimaryDark">#6D5BFF</Color>
    <Color x:Key="PrimaryPressedLight">#0D63D8</Color>
    <Color x:Key="PrimaryPressedDark">#8373FF</Color>
    <Color x:Key="PrimarySoftLight">#132D55</Color>
    <Color x:Key="PrimarySoftDark">#1B1B54</Color>

    <Color x:Key="Info">#23D7FF</Color>
    <Color x:Key="InfoSoftLight">#092D3B</Color>
    <Color x:Key="InfoSoftDark">#092D3B</Color>

    <Color x:Key="Warning">#FFB84D</Color>
    <Color x:Key="WarningSoftLight">#3A2609</Color>
    <Color x:Key="WarningSoftDark">#3A2609</Color>

    <Color x:Key="Danger">#FF5C7A</Color>
    <Color x:Key="DangerSoftLight">#3C101B</Color>
    <Color x:Key="DangerSoftDark">#3C101B</Color>

    <Color x:Key="Success">#4BE28A</Color>
    <Color x:Key="SuccessSoftLight">#0D3523</Color>
    <Color x:Key="SuccessSoftDark">#0D3523</Color>

    <!-- Legacy aliases kept intentionally so existing pages keep compiling while the UI is migrated. -->
    <Color x:Key="DoodleInk">#F6F8FF</Color>
    <Color x:Key="DoodlePaper">#0B1220</Color>
    <Color x:Key="DoodleShadow">#132D55</Color>

    <Color x:Key="White">#FFFFFF</Color>
    <Color x:Key="Black">#000000</Color>
    <Color x:Key="Gray50">#F6F8FF</Color>
    <Color x:Key="Gray100">#DDE6F8</Color>
    <Color x:Key="Gray200">#B8C3D9</Color>
    <Color x:Key="Gray300">#93A1BC</Color>
    <Color x:Key="Gray400">#6F7C96</Color>
    <Color x:Key="Gray500">#536179</Color>
    <Color x:Key="Gray600">#36445C</Color>
    <Color x:Key="Gray700">#1D2A42</Color>
    <Color x:Key="Gray800">#111A2E</Color>
    <Color x:Key="Gray900">#091121</Color>
    <Color x:Key="Gray950">#050912</Color>

    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Primary}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceLight}" />
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="{StaticResource SurfaceAltLight}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderLight}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource Danger}" />
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource Success}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource Warning}" />
</ResourceDictionary>
